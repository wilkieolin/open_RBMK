*==============================================================
* RBMK-1000 3D Transient Simulation
* SCRAM with graphite displacer effect, xenon oscillations, void excursions
*==============================================================
LINKED_LIST RBMK MACRO TRACK TRACK_A SYSTEM DEVICE FLUX0 FLUX ;
MODULE GEO: MAC: ASM: TRIVAT: TRIVAA: DEVINI: FLUD: FLU: GREP: END: ;
PROCEDURE assertS ;

REAL Keff ;

*==============================================================
* GEOMETRY: 3D Cartesian core (49x49x28, 25cm pitch, 7m active)
* Mix 1 = Fuel channel, Mix 2 = Graphite, Mix 0 = Void
*==============================================================
RBMK := GEO: :: CAR3D 49 49 28
EDIT 2
X- VOID  X+ VOID
Y- VOID  Y+ VOID
Z- VOID  Z+ VOID
MIX
PLANE 1
