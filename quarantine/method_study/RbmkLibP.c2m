*DECK RbmkLibP
*----
*  METHOD-STUDY VARIANT of RbmkLib.c2m (hypothesis H8, PROGRESS.md "Method gap").
*  Identical except that the main heavy nuclides produced by depletion are
*  listed explicitly in the fuel mixtures, at zero initial concentration, with
*  the same self-shielding set as the uranium of that mixture (1 inner, 2
*  outer).  RbmkLib lists only U235/U238, so these nuclides enter only through
*  the depletion chain -- and, like rep900_mco_proc/Mix_UOX_32.c2m:253-258
*  implies, then carry no self-shielding set at all.  Not for production use.
*----
*----
*  RBMK-1000 microscopic library.  Single source of truth for all material
*  compositions -- both the A3 cell deck and the A5 branch deck call this, so
*  they cannot drift apart.  (The deck this replaces kept two copies of the
*  LIB: block, and they disagreed about what the coolant-density argument
*  meant, which silently mislabelled every point on the void axis.)
*
*  2026-09-23: coolant hydrogen corrected from free-gas H1 to bound H1_H2O.
*  Free-gas hydrogen has no bound-water thermal scattering law; it overstates
*  water's moderating power and so suppresses the positive void coefficient.
*  Measured in rbmk_h2otest.x2m: k-inf 1.312816 -> 1.310172, and full-void
*  worth at zero burnup +82 -> +222 pcm.  RbmkLibF.c2m keeps the old free-gas
*  composition so that comparison stays reproducible.
*
*  Called as:  LIBRARY := RbmkLib :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
*    dca    coolant density, ABSOLUTE g/cm3 (nominal 0.72)
*    tfuel  fuel temperature K
*    tgrap  graphite temperature K
*    tcool  coolant / structure temperature K
*
*  Enrichment is 2.0 wt% U-235 -- the Chernobyl Unit 4 loading, April 1986.
*  Number densities are computed from density and composition, never copied.
*  See rbmk_cell_a3.x2m for the geometry these mixtures belong to.
*----
PARAMETER LIBRARY ::
   EDIT 0
      ::: LINKED_LIST LIBRARY ;
;
MODULE LIB: END: ;

REAL dca tfuel tgrap tcool ;
:: >>dca<< >>tfuel<< >>tgrap<< >>tcool<< ;

*  Water at the nominal 0.72 g/cm3 -> N(H1) = 4.81360E-2, N(O16) = 2.40680E-2
REAL dca_nom := 0.72 ;
REAL nH1  := 4.81360E-2 dca * dca_nom / ;
REAL nO16 := 2.40680E-2 dca * dca_nom / ;

LIBRARY := LIB: ::
  EDIT 0
  NMIX 9
  CTRA APOL
  ANIS 2
  SUBG
  DEPL LIB: DRAGON FIL: DLIB_99
  MIXS LIB: DRAGON FIL: DLIB_99

* MIX 1: channel coolant, H2O
  MIX     1  <<tcool>>
     H1_H2O  = H1_H2O  <<nH1>>
     O16     = O16     <<nO16>>

* MIX 2: pressure tube, Zr-2.5%Nb at 6.55 g/cm3
  MIX     2  <<tcool>>
     Zr90    = Zr90    2.16890E-2
     Zr91    = Zr91    4.72990E-3
     Zr92    = Zr92    7.22980E-3
     Zr94    = Zr94    7.32670E-3
     Zr96    = Zr96    1.18040E-3
     Nb93    = Nb93    1.06140E-3

* MIX 3: gas gaps and pellet centre hole, He at 1 atm
  MIX     3  <<tcool>>
     He4     = He4     1.28100E-5

* MIX 4: graphite rings, 1.65 g/cm3
  MIX     4  <<tgrap>>
     C12_GR  = C12_GR  8.27260E-2

* MIX 5: graphite block, 1.65 g/cm3
  MIX     5  <<tgrap>>
     C12_GR  = C12_GR  8.27260E-2

* MIX 6: UO2 fuel, inner ring (6 rods), 2.0 wt% U-235, 10.4 g/cm3
  MIX     6  <<tfuel>>
     U235    = U235    4.69750E-4  1
     U238    = U238    2.27272E-2  1
     U236    = U236    0.0  1
     Np237   = Np237   0.0  1
     Pu238   = Pu238   0.0  1
     Pu239   = Pu239   0.0  1
     Pu240   = Pu240   0.0  1
     Pu241   = Pu241   0.0  1
     Pu242   = Pu242   0.0  1
     Am241   = Am241   0.0  1
     O16     = O16     4.63940E-2

* MIX 7: UO2 fuel, outer ring (12 rods) -- separate self-shielding set
  MIX     7  <<tfuel>>
     U235    = U235    4.69750E-4  2
     U238    = U238    2.27272E-2  2
     U236    = U236    0.0  2
     Np237   = Np237   0.0  2
     Pu238   = Pu238   0.0  2
     Pu239   = Pu239   0.0  2
     Pu240   = Pu240   0.0  2
     Pu241   = Pu241   0.0  2
     Pu242   = Pu242   0.0  2
     Am241   = Am241   0.0  2
     O16     = O16     4.63940E-2

* MIX 8: cladding, Zr-1%Nb at 6.55 g/cm3
  MIX     8  600.0
     Zr90    = Zr90    2.20240E-2
     Zr91    = Zr91    4.80290E-3
     Zr92    = Zr92    7.34120E-3
     Zr94    = Zr94    7.43970E-3
     Zr96    = Zr96    1.19860E-3
     Nb93    = Nb93    4.24560E-4

* MIX 9: central carrier rod, Zr-1%Nb
  MIX     9  <<tcool>>
     Zr90    = Zr90    2.20240E-2
     Zr91    = Zr91    4.80290E-3
     Zr92    = Zr92    7.34120E-3
     Zr94    = Zr94    7.43970E-3
     Zr96    = Zr96    1.19860E-3
     Nb93    = Nb93    4.24560E-4
;

END: ;
QUIT .
