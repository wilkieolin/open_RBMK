*==============================================================
*  Export COMPO to disk
*==============================================================
ACOMPO := COMPO ;

* Print 2-group macrolib (last branch)
MACRO_2G := EDI7 :: STEP UP COND2 ;
GREP: MACRO_2G :: GETVAL 'DIRECTORY' ;

END: ;
QUIT "LIST" .