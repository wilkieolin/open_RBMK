*==============================================================
*  MACROLIB: DLIB_99-derived 2-group XS (volume-weighted Fuel + Moderator)
*  Fuel = volume-weighted average of 4 fuel rings (regions 6-9)
*  Moderator = volume-weighted average of coolant, tubes, graphite, sheath (regions 1-5,10)
*  1 MeV group cutoff (fast > 1 MeV, thermal < 1 MeV)
*==============================================================
MACRO := MAC: ::
  EDIT 2 NGRO 2 NMIX 2 NIFI 1
  READ INPUT
  MIX     1
      DIFFX  1.9182E+00  1.0176E+00
      TOTAL  2.7915E-01  5.6688E-01
     NUSIGF  2.6358E-02  9.6041E-02
   H-FACTOR  2.6358E-02  9.6041E-02
       SCAT  2 2  5.7481E-02  2.1075E-01  2 2  4.7863E-01  0.0000E+00
  ;
  MIX     2
      DIFFX  5.1150E+00  2.2673E+00
      TOTAL  1.0922E-01  2.9354E-01
     NUSIGF  0.0000E+00  0.0000E+00
   H-FACTOR  0.0000E+00  0.0000E+00
       SCAT  2 2  2.1079E-02  8.8108E-02  2 2  2.9305E-01  0.0000E+00
  ;
  ;

*==============================================================
*  USPLIT: Split geometry into fuel/reflector (fuel=1, reflector=2)
*==============================================================
RBMK_2 MATEX := USPLIT: RBMK :: EDIT 1
  NGRP 2 MAXR 100000 NMIX 2
  NREFL 1 RMIX 2
  NFUEL 1 FMIX 1
  ;

*==============================================================
*  MACINI: Initialize macrolib (called BEFORE TRIVAT)
*==============================================================
MACRO2 MATEX := MACINI: MATEX MACRO :: EDIT 1 ;

*==============================================================
*  TRACKING: 3D transport (TRIVAT) - uses RBMK_2 from USPLIT
*==============================================================
TRACK := TRIVAT: RBMK_2 ::
      TITLE 'RBMK-1000 3D CORE DLIB99'
      EDIT 1 MAXR 100000 DUAL 3 3 ;

*==============================================================
*  ASSEMBLY: System matrices
*==============================================================
SYSTEM := TRIVAA: MACRO2 TRACK ::
      EDIT 1 ;

*==============================================================
*  FLUX: 3D k-eigenvalue solution
*==============================================================
FLUX := FLUD: SYSTEM TRACK ::
      EDIT 2 EXTE 1.0E-7 1000 ;

*==============================================================
*  Output
*==============================================================
GREP: FLUX :: EDIT 2 K-EFF ;
GREP: FLUX :: EDIT 2 FLUX ;

assertS FLUX :: 'K-EFFECTIVE' 1 1.0 ;

END: ;
QUIT "LIST" .
