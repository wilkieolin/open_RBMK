MESHZ 0 25 50 75 100 125 150 175 200 225 250 275 300 325 350 375 400
425 450 475 500 525 550 575 600 625 650 675 700
;

*==============================================================
* MACRO: 2-group cross sections
*==============================================================
MACRO := MAC: ::
EDIT 2 NGRO 2 NMIX 2 NIFI 1
READ INPUT

* MIX 1: Fuel channel (homogenized)
MIX     1
    DIFF  1.500E+00  4.000E-01
    TOTAL  3.012E-02  7.000E-02
   NUSIGF  0.000E+00  1.600E-01
     CHI  1.000E+00  0.000E+00
 H-FACTOR  0.000E+00  1.600E-01
     SCAT  1 1 0.0  2 2 0.0  2.00E-02

* MIX 2: Graphite moderator
MIX     2
    DIFF  1.950E+00  2.850E-01
    TOTAL  3.000E-04  2.000E-04
   NUSIGF  0.000E+00  0.000E+00
     CHI  0.000E+00  0.000E+00
 H-FACTOR  0.000E+00  0.000E+00
     SCAT  1 1 0.0  2 2 0.0  3.90E-02

;

*==============================================================
* TRIVAT: 3D tracking
*==============================================================
TRACK := TRIVAT: RBMK MACRO ::
EDIT 1
TITLE 'RBMK-1000 3D TRIVAC TRACKING'
;

*==============================================================
* ASM: Build system matrices
*==============================================================
SYSTEM := ASM: MACRO TRACK :: EDIT 1 ;

*==============================================================
* FLUD: Direct flux (steady-state initialization)
*==============================================================
FLUX0 := FLUD: SYSTEM TRACK ::
EDIT 2 EXTE 1.0E-7 1000 ;
GREP: FLUX0 :: GETVAL 'K-EFFECTIVE' 1 >>Keff<< ;
ECHO "Initial Keff=" Keff ;
assertS FLUX0 :: 'K-EFFECTIVE' 1 1.005 ;

*==============================================================
* INIKIN: Initialize kinetics parameters
*==============================================================
KINET_0 := INIKIN: MACRO TRACK SYSTEM FLUX0 ::
EDIT 1
NORM POWER-INI 3200.0
;

*==============================================================
* KINSOL: Transient flux solver
*==============================================================
KINET := KINSOL: KINET_0 MACRO TRACK SYSTEM MACRO SYSTEM ::
EDIT 1
DELTA 0.1
SCHEME FLUX CRANK
PREC EXPON
;

* Output
GREP: KINET :: GETVAL 'E-POW' 1 >>Powf<< ;
ECHO "Final Power (MW)=" Powf ;
GREP: KINET :: GETVAL 'K-EFFECTIVE' 1 >>Keff<< ;
ECHO "Final Keff=" Keff ;

END: ;
QUIT .
