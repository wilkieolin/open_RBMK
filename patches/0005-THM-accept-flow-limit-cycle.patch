@@ -255,6 +259,19 @@
       ITERC=0
    20 ITERC=ITERC+1
       IF(ITERC.GT.MAXITC) THEN
+*        RBMK local patch 0005.  The flow iteration can lock into a limit
+*        cycle instead of converging: the boiling-onset node K0 is an
+*        integer reset every pass (K0=0 above, set in THMH2O), so a node at
+*        the onset threshold flips its density by a finite step, and the
+*        mass flux built from (DCOOL0-DCOOL)*DTINV*HZ moves by that step
+*        over 2*DTIME -- an amplitude that GROWS as the time step shrinks.
+*        With CYCLE-OK <cap> on THM:, accept the last iterate when the
+*        cycle's error is below the cap, and count it; above it, abort.
+         IF((CYCCAP.GT.0.0).AND.(ERR.LT.CYCCAP)) THEN
+           NCYC=NCYC+1
+           ERRCYC=MAX(ERRCYC,ERR)
+           GO TO 30
+         ENDIF
          CALL XABORT('THMTRS: CONVERGENCE FAILURE IN FLOW CALCULATION.')
       ENDIF
