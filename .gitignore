# Build artifacts
install/
build/

# Submodules (managed via git submodule)
5.1/
armi/
libraries/

# Build logs
*.log

# OS/Editor files
.DS_Store
*~
.*.swp
.vscode/
.idea/
_DUMMY

# ---------------------------------------------------------------------------
# Generated artifacts.  Everything below is reproducible from the decks and
# scripts that ARE tracked; none of it should ever be the only copy of a result.
# ---------------------------------------------------------------------------

# Python virtualenv for OpenMC (761 MB)
.venv-openmc/
__pycache__/
*.pyc

# OpenMC run directories: statepoints, summaries, depletion results.
# The distilled numbers live in openmc/*.json, which IS tracked.
openmc/run*/
openmc/depl*/
openmc/branch81*/
openmc/branch_gb10*/
openmc/branch_accref/
openmc/beta81*/
openmc/rates_d*/
openmc/rates10p_d*/
openmc/meth_*/
openmc/srp94_*_*/
openmc/candu_v*/
openmc/smoke_depl/
*.h5

# DRAGON/DONJON generated output.  `.result` listings are rebuilt by rerunning
# the deck -- and standing rule 5 says delete them before you do.
*.result
Linux_*/
Darwin_*/

# Exported MULTICOMPO databases.  _ACompo alone is 114 MB and is rebuilt by
# rbmk_a5b_compo.x2m in 81 minutes.
_ACompo*
ACOMPO*

# Draglibs decompressed out of the `libraries` submodule by
# decks/common/dlib99.access, so the submodule itself stays clean.
.cache/

# Stage-0 scratch from the pre-submodule build scripts.
src/
nuclear-data/
regress/

# Third-party source documents (see sources/README.md for where to get each)
sources/*
!sources/README.md
# our own digitisations of those documents (tools/digitise_*.py) are tracked
!sources/derived/
*:Zone.Identifier
openmc/cps_runs/

# A6.5 leakage study: tools/u4_leakage.sh seds these out of the two generated
# core decks and runs them.  Eight near-identical 70 kB files whose only
# authority is the script; u4_leakage.txt (tracked) is the result.
decks/Donjon/data/u4lk_*.don
decks/Donjon/data/u4lk_*.don.access

# A6.5 rod study: tools/u4_rods.sh regenerates every rod configuration from
# gen_rbmk_unit4.py (U4_RODS / U4_TILT).  Only the two base decks and the
# result table (u4_rods.txt) are tracked.
decks/Donjon/data/rbmk_unit4_core_*.don
decks/Donjon/data/rbmk_unit4_core_*.don.access
decks/Donjon/data/rbmk_unit4_norefl_*.don
decks/Donjon/data/rbmk_unit4_norefl_*.don.access
