*DECK RbmkCpsLib
*----
*  CPS-channel mixtures, added to a LIBRARY that already holds the fuel
*  cell (RbmkLib, optionally with burned fuel from LIB: ... BURN).
*  GENERATED by openmc/cps_common.py -- edit that, not this file.
*
*  Called as:  LIBRARY := RbmkCpsLib LIBRARY :: <<b4c>> <<dsp>> <<tdsp>> ;
*    b4c   B4C density g/cm3 (open input: 1.7-2.3, nominal 2.0)
*    dsp   displacer graphite density g/cm3 (1.50-1.73, nominal 1.65)
*    tdsp  displacer graphite temperature K
*  Number densities scale linearly with the densities given.
*----
PARAMETER LIBRARY ::
   EDIT 0
      ::: LINKED_LIST LIBRARY ;
;
MODULE LIB: END: ;
REAL b4c dsp tdsp ;
:: >>b4c<< >>dsp<< >>tdsp<< ;
REAL nB10B := 8.675458E-03 b4c * ;
REAL nB11B := 3.491981E-02 b4c * ;
REAL nC12B := 1.089882E-02 b4c * ;
REAL nC12D := 5.013855E-02 dsp * ;

LIBRARY := LIB: LIBRARY ::
  EDIT 0
  NMIX 15
  MIXS LIB: DRAGON FIL: DLIB_99

* MIX 10: CPS water, 50 C
  MIX     10  323.15
     H1_H2O  = H1_H2O  6.60537E-02
     O16     = O16     3.30268E-02

* MIX 11: SAV-1 Al alloy
  MIX     11  323.15
     Si28    = Si28    5.07219E-04
     Si29    = Si29    2.57671E-05
     Si30    = Si30    1.70057E-05
     Mg24    = Mg24    3.56693E-04
     Mg25    = Mg25    4.51568E-05
     Mg26    = Mg26    4.97176E-05
     Fe54    = Fe54    1.70182E-06
     Fe56    = Fe56    2.67150E-05
     Fe57    = Fe57    6.16966E-07
     Fe58    = Fe58    8.21069E-08
     Al27    = Al27    5.92232E-02

* MIX 12: B4C natural B, 2.0 g/cm3
  MIX     12  623.15
     B10     = B10     <<nB10B>>
     B11     = B11     <<nB11B>>
     C12     = C12     <<nC12B>>

* MIX 13: displacer graphite, 1.65 g/cm3
  MIX     13  <<tdsp>>
     C12_GR  = C12_GR  <<nC12D>>

* MIX 14: CPS tube Zr-2.5Nb
  MIX     14  323.15
     Zr90    = Zr90    2.16890E-02  6
     Zr91    = Zr91    4.72990E-03  6
     Zr92    = Zr92    7.22980E-03  6
     Zr94    = Zr94    7.32670E-03  6
     Zr96    = Zr96    1.18040E-03  6
     Nb93    = Nb93    1.06140E-03

* MIX 15: He, sealed gaps and drained channel
  MIX     15  323.15
     He4     = He4     1.28100E-05
  ;

END: ;
QUIT .
