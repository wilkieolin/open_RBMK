*DECK RbmkReflLib
*----
*  Radial-reflector mixtures, added to a LIBRARY that already holds
*  the fuel cell (RbmkLib, optionally with burned fuel).
*  GENERATED by openmc/refl.py -- edit that, not this file.
*
*  Called as:  LIBRARY := RbmkReflLib LIBRARY :: <<tgr>> <<rhogr>> ;
*    tgr    reflector graphite temperature K (OPEN INPUT: the
*           reflector runs cooler than the core's 750 K and no
*           source in hand gives a number -- run it as a band)
*    rhogr  reflector graphite density g/cm3 ([D]: 1.65)
*
*  The steel is NOT self-shielded: its Fe, Cr and Ni resonances sit
*  at infinite dilution, as B10/B11 do in RbmkCpsLib.  It is a thin
*  tube in the outermost of four rings, where the flux is already
*  down by orders of magnitude, but that is an argument and not a
*  measurement -- it is on the list to check, not established.
*----
PARAMETER LIBRARY ::
   EDIT 0
      ::: LINKED_LIST LIBRARY ;
;
MODULE LIB: END: ;
REAL tgr rhogr ;
:: >>tgr<< >>rhogr<< ;
REAL nC12R := 5.013855E-02 rhogr * ;

LIBRARY := LIB: LIBRARY ::
  EDIT 0
  NMIX 18
  MIXS LIB: DRAGON FIL: DLIB_99

* MIX 16: reflector graphite
  MIX     16  <<tgr>>
     C12_GR  = C12_GR  <<nC12R>>

* MIX 17: 08Kh18N10T Field tube
  MIX     17  323.15
     C12     = C12     3.16876E-04
     Si28    = Si28    1.24976E-03
     Si29    = Si29    6.34886E-05
     Si30    = Si30    4.19011E-05
     Mn55    = Mn55    1.73195E-03
     Cr50    = Cr50    7.15599E-04
     Cr52    = Cr52    1.37996E-02
     Cr53    = Cr53    1.56476E-03
     Cr54    = Cr54    3.89503E-04
     Ni58    = Ni58    5.51809E-03
     Ni60    = Ni60    2.12556E-03
     Ni61    = Ni61    9.23965E-05
     Ni62    = Ni62    2.94600E-04
     Ni64    = Ni64    7.50260E-05
     Ti46    = Ti46    5.73976E-05
     Ti47    = Ti47    5.17622E-05
     Ti48    = Ti48    5.12891E-04
     Ti49    = Ti49    3.76389E-05
     Ti50    = Ti50    3.60387E-05
     Fe54    = Fe54    3.40691E-03
     Fe56    = Fe56    5.34813E-02
     Fe57    = Fe57    1.23512E-03
     Fe58    = Fe58    1.64371E-04

* MIX 18: reflector cooling water
  MIX     18  323.15
     H1_H2O  = H1_H2O  6.60537E-02
     O16     = O16     3.30268E-02
  ;

END: ;
QUIT .
