*DECK RbmkScRefl
*----
*  Core/reflector strip: 4 fuel cells, 3 graphite
*  reflector columns, 1 water-cooled column.  [D] p.9: the lateral
*  reflector is 1 m = 4 columns; [BEH96] II.B and [D] agree the outermost
*  carries the 156 cooling channels.
*  GENERATED by openmc/refl.py -- edit that, not this file.
*
*  X- REFL  an infinite core beyond the fuel side
*  X+ VOID  outside the graphite stack
*  Y+/Y- REFL  the strip repeats along the reflector face
*
*  The fuel cell is RbmkGeo.c2m's, verbatim, so this and the CPS supercells
*  cannot drift apart.
*----
PARAMETER GEOSS GEOFL ::
   EDIT 0
      ::: LINKED_LIST GEOSS GEOFL ;
;
MODULE GEO: END: ;
INTEGER k ;
:: >>k<< ;
INTEGER k1 := 1 k * ;
INTEGER k2 := 2 k * ;
INTEGER k3 := 3 k * ;
INTEGER k4 := 4 k * ;
INTEGER k6 := 6 k * ;

GEOSS := GEO: :: CAR2D 8 1
  EDIT 0
  X- REFL X+ REFL  Y- REFL Y+ REFL
  MESHX 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0  MESHY 0.0 25.0
  CELL F F F F G G G W
  ::: F := GEO: CARCEL 5
    MESHX 0.0 25.0 MESHY 0.0 25.0
    RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
    MIX     1        2      3      4      5      5
    CLUSTER CARR ROD1 ROD2
    ::: CARR := GEO: TUBE 3
      MIX  9 1 9   NPIN 1  RPIN 0.00  APIN 0.00
      RADIUS 0.0000 0.6000 0.6250 0.7500 ;
    ::: ROD1 := GEO: TUBE 4
      MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
      RADIUS 0.0000 0.1000 0.5750 0.5850 0.6790 ;
    ::: ROD2 := GEO: ROD1
      MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
    ;
  ::: G := GEO: CARCEL 2
    MESHX 0.0 25.0 MESHY 0.0 25.0
    RADIUS 0.0000 5.7000 11.0000
    MIX 16 16 16
    ;
  ::: W := GEO: CARCEL 4
    MESHX 0.0 25.0 MESHY 0.0 25.0
    RADIUS 0.0000 3.4000 3.8000 5.7000 11.0000
    MIX 18 17 3 16 16
    ;
  ;

GEOFL := GEO: :: CAR2D 8 1
  EDIT 0
  X- REFL X+ REFL  Y- REFL Y+ REFL
  MESHX 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0  MESHY 0.0 25.0
  CELL F F F F G G G W
  ::: F := GEO: CARCEL 5
    MESHX 0.0 25.0 MESHY 0.0 25.0
    RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
    MIX     1        2      3      4      5      5
    SPLITR <<k4>> <<k1>> <<k1>> <<k2>> <<k6>>
    CLUSTER CARR ROD1 ROD2
    ::: CARR := GEO: TUBE 3
      MIX  9 1 9   NPIN 1  RPIN 0.00  APIN 0.00
      RADIUS 0.0000 0.6000 0.6250 0.7500 SPLITR <<k1>> <<k1>> <<k1>> ;
    ::: ROD1 := GEO: TUBE 4
      MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
      RADIUS 0.0000 0.1000 0.5750 0.5850 0.6790 SPLITR <<k1>> <<k3>> <<k1>> <<k1>> ;
    ::: ROD2 := GEO: ROD1
      MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
    ;
  ::: G := GEO: CARCEL 2
    MESHX 0.0 25.0 MESHY 0.0 25.0
