*DECK RbmkScOne
*----
*  1 fuel cell(s), X+ REFL.  GENERATED by a one-off; kept.
*  Controls for the reflector work: a fully reflected fuel region must
*  reproduce the fuel cell's own k-inf, and if it does not then the strip
*  geometry or its tracking is the problem, not diffusion theory.
*----
PARAMETER GEOSS GEOFL ::
   EDIT 0
      ::: LINKED_LIST GEOSS GEOFL ;
;
MODULE GEO: END: ;
INTEGER k ;
:: >>k<< ;
INTEGER k1 := 1 k * ;
INTEGER k2 := 2 k * ;
INTEGER k3 := 3 k * ;
INTEGER k4 := 4 k * ;
INTEGER k6 := 6 k * ;

GEOSS := GEO: :: CAR2D 1 1
  EDIT 0
  X- REFL X+ REFL  Y- REFL Y+ REFL
  MESHX 0.0 25.0  MESHY 0.0 25.0
  CELL F
  ::: F := GEO: CARCEL 5
    MESHX 0.0 25.0 MESHY 0.0 25.0
    RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
    MIX     1        2      3      4      5      5
    CLUSTER CARR ROD1 ROD2
    ::: CARR := GEO: TUBE 3
      MIX  9 1 9   NPIN 1  RPIN 0.00  APIN 0.00
      RADIUS 0.0000 0.6000 0.6250 0.7500 ;
    ::: ROD1 := GEO: TUBE 4
      MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
      RADIUS 0.0000 0.1000 0.5750 0.5850 0.6790 ;
    ::: ROD2 := GEO: ROD1
      MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
    ;
  ;

GEOFL := GEO: :: CAR2D 1 1
  EDIT 0
  X- REFL X+ REFL  Y- REFL Y+ REFL
  MESHX 0.0 25.0  MESHY 0.0 25.0
  CELL F
  ::: F := GEO: CARCEL 5
    MESHX 0.0 25.0 MESHY 0.0 25.0
    RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
    MIX     1        2      3      4      5      5
    SPLITR <<k4>> <<k1>> <<k1>> <<k2>> <<k6>>
    CLUSTER CARR ROD1 ROD2
    ::: CARR := GEO: TUBE 3
      MIX  9 1 9   NPIN 1  RPIN 0.00  APIN 0.00
      RADIUS 0.0000 0.6000 0.6250 0.7500 SPLITR <<k1>> <<k1>> <<k1>> ;
    ::: ROD1 := GEO: TUBE 4
      MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
      RADIUS 0.0000 0.1000 0.5750 0.5850 0.6790 SPLITR <<k1>> <<k3>> <<k1>> <<k1>> ;
    ::: ROD2 := GEO: ROD1
      MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
    ;
  ;

END: ;
QUIT .
