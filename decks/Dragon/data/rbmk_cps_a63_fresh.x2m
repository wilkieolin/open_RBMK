SCTRKSS SCFTRKSS := NXT: SCSS :: EDIT 0 TITLE 'SC-SS' ALLG BATCH 100 TISO 8 15.0 ;
SCTRK SCFTRK := NXT: SCFL :: EDIT 0 TITLE 'SC-FL' ALLG BATCH 100 TISO 15 30.0 ;

