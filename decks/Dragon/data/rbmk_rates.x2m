*----
*  RBMK-1000 -- WHERE DOES DRAGON PUT THE ABSORPTION?
*
*  OpenMC (ENDF/B-VIII.1, continuous energy) and DRAGON (same evaluation,
*  172 groups) agree on k-inf to +550 pcm but differ by 4x on the full-void
*  reactivity (+912 vs +222 pcm).  The OpenMC reaction-rate decomposition
*  shows the void effect is a small residual: voiding removes 4.9% of all
*  absorption with the water, and U-238 epithermal resonance capture grows
*  back ~70% of it as the spectrum hardens.  The net is what disagrees.
*
*  Closing the gap would need DRAGON to over-predict the GROWTH in U-238
*  epithermal capture by roughly 30%.  This deck measures it instead of
*  assuming it: a 2-group edition (cut at 0.625 eV, MERG COMP) with MICR ALL
*  at nominal and voided density, so the per-isotope absorption rates can be
*  compared directly against the OpenMC tallies.
*
*  Bound hydrogen (RbmkLib ) throughout.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX EDIT2G DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: EDI: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLib ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 2 ;
INTEGER iv ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.02 ;

GEOSS := GEO: :: CARCEL 5
  EDIT 0
  X- REFL X+ REFL MESHX -12.5 12.5
  Y- REFL Y+ REFL MESHY -12.5 12.5
  RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
  MIX     1        2      3      4      5      5
  CLUSTER CARR ROD1 ROD2
  ::: CARR := GEO: TUBE 2
    MIX  1 9   NPIN 1  RPIN 0.00  APIN 0.00
    RADIUS 0.0000 0.5000 0.6500 ;
  ::: ROD1 := GEO: TUBE 4
    MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
    RADIUS 0.0000 0.1000 0.5750 0.5975 0.6800 ;
  ::: ROD2 := GEO: ROD1
    MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
  ;
GEOFL := GEO: GEOSS :: SPLITR 4 1 1 2 6
  ::: CARR := GEO: CARR SPLITR 1 1 ;
  ::: ROD1 := GEO: ROD1 SPLITR 1 3 1 1 ;
  ::: ROD2 := GEO: ROD2 SPLITR 1 3 1 1 ;
  ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'RATE-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'RATE-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

EVALUATE iv := 0 ;
WHILE iv ndc < DO
  EVALUATE iv := iv 1 + ;
  GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;
  LIBRARY := RbmkLib  :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
  LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
  SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
  FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
  GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
  ECHO "RATEHDR dca" dca "kinf" kinf ;

*  2-group, whole-cell homogenized edition with per-isotope detail.
*  EDIT 4 prints the condensed microscopic cross sections and the flux.
  EDIT2G := EDI: LIBSS TRK FLUX GEOFL SYS ::
    EDIT 4 MICR ALL MERG COMP COND 0.625 SAVE ON RATE2G ;

  EDIT2G LIBRARY LIBSS SYS FLUX := DELETE:
    EDIT2G LIBRARY LIBSS SYS FLUX ;
ENDWHILE ;

ECHO "rbmk_rates completed" ;
END: ;
QUIT .
