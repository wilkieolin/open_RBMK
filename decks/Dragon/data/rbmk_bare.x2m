*----
*  How much is the reflector WORTH, in transport?
*  Four fuel cells, vacuum against the fuel -- the bare counterpart of
*  rbmk_refl.x2m's 4F+3G+1W strip.  The difference in reactivity between the
*  two IS the reflector worth, and comparing it with what DONJON's diffusion
*  model makes of the same data says whether the 16187 pcm strip error
*  matters in a core, where the reflector is a thin skin rather than half the
*  problem.  GENERATED by a one-off; kept because the number matters.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: END: ;
PROCEDURE   RbmkLib RbmkScBare ;
REAL tgnom := 750.0 ;
REAL tcool := 573.0 ;
REAL kinf ;

GEOSS GEOFL := RbmkScBare :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'BR-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'BR-FL' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "BARETAB 0.0 0.72" kinf ;

ECHO "rbmk_bare completed" ;
END: ;
QUIT .
