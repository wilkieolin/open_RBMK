*----
*  A6.5 / Phase 1b -- WHY DOES SPH NOT CONVERGE ON THE REFLECTOR?
*  GENERATED by a one-off in the session log; kept because the answer matters.
*
*  rbmk_refl.x2m's SPH hits the 200-iteration cap in all four states, with
*  "negative SPH factor ... set to 1.0" in EVERY region of group 1 -- a total
*  breakdown of the equivalence, not slow convergence.  This reads back the
*  persisted L_EDIT of the first state and tries the normalisations and
*  discretisations against it.  Seconds per variant, because the transport is
*  already done.
*
*  Variants: normalisation (ASYM on the fuel end, STD, ASYM on the outer
*  reflector cell), macro-discretisation (DUAL 1 1 / MCFD 1 / DUAL 3 3), and
*  a looser tolerance with more iterations.
*----
LINKED_LIST GEOMAC MT0 MT1 MT2 EA EB EC ED EE EF ;
SEQ_ASCII   _EdiRefl :: FILE './_EdiRefl' ;
MODULE      GEO: TRIVAT: SPH: DELETE: END: ;

GEOMAC := GEO: :: CAR2D 8 1
  X- REFL X+ VOID  Y- REFL Y+ REFL
  MESHX 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0  MESHY 0.0 25.0
  MIX 1 2 3 4 5 6 7 8 ;
MT0 := TRIVAT: GEOMAC :: EDIT 0 MAXR 40 DUAL 1 1 ;
MT1 := TRIVAT: GEOMAC :: EDIT 0 MAXR 40 DUAL 3 3 ;
MT2 := TRIVAT: GEOMAC :: EDIT 0 MAXR 40 MCFD 1 ;

ECHO "SPHTRY A track=DUAL 1 1 norm=ASYM 1 iter=1.0E-6 200" ;
EA := _EdiRefl ;
EA := SPH: EA MT0 :: EDIT 1 ASYM 1 ITER 1.0E-6 200 ;
EA := DELETE: EA ;

ECHO "SPHTRY B track=DUAL 1 1 norm=STD iter=1.0E-6 200" ;
EB := _EdiRefl ;
EB := SPH: EB MT0 :: EDIT 1 STD ITER 1.0E-6 200 ;
EB := DELETE: EB ;

ECHO "SPHTRY C track=DUAL 1 1 norm=ASYM 8 iter=1.0E-6 200" ;
EC := _EdiRefl ;
EC := SPH: EC MT0 :: EDIT 1 ASYM 8 ITER 1.0E-6 200 ;
EC := DELETE: EC ;

ECHO "SPHTRY D track=MCFD 1 norm=ASYM 1 iter=1.0E-6 200" ;
ED := _EdiRefl ;
ED := SPH: ED MT2 :: EDIT 1 ASYM 1 ITER 1.0E-6 200 ;
ED := DELETE: ED ;

ECHO "SPHTRY E track=DUAL 1 1 norm=ASYM 1 iter=1.0E-4 500" ;
EE := _EdiRefl ;
EE := SPH: EE MT0 :: EDIT 1 ASYM 1 ITER 1.0E-4 500 ;
EE := DELETE: EE ;

ECHO "SPHTRY F track=DUAL 3 3 norm=ASYM 1 iter=1.0E-6 200" ;
EF := _EdiRefl ;
EF := SPH: EF MT1 :: EDIT 1 ASYM 1 ITER 1.0E-6 200 ;
EF := DELETE: EF ;

ECHO "rbmk_refl_sph completed" ;
END: ;
QUIT .
