*----
*  RBMK-1000 -- DOES THE TRANSPORT CORRECTION DRIVE THE VOID DISAGREEMENT?
*
*  With geometry, composition, nuclear data (ENDF/B-VIII.1) and hydrogen
*  treatment (H1_H2O) all matched, DRAGON gives +222 pcm full-void and OpenMC
*  +912.  The gap is localised to U-235 fission production.  Already ruled out
*  as causes: GRMIN (bit-identical to the library default) and the USS:
*  options (TRAN PASS 4 NOCO moves k by under 0.5 pcm).
*
*  The transport correction is a candidate precisely because this is a
*  DERIVATIVE.  Hydrogen is by far the most anisotropic scatterer in the cell,
*  so removing it changes what CTRA is correcting for; a correction that is
*  adequate at nominal density need not be adequate at both endpoints.
*  OpenMC treats scattering anisotropy exactly.
*
*  ic=1 CTRA APOL (what A3 and A5 use)   ic=2 CTRA NONE   ic=3 CTRA WIMS
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLib RbmkLibN RbmkLibW RbmkGeo ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 3 ;
INTEGER iv ic ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.35 0.02 ;

*  Both geometries come from rbmk_proc/RbmkGeo.c2m, the single source of
*  truth for the cell -- see its header for every dimension and source.
GEOSS GEOFL := RbmkGeo ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'CTRA-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'CTRA-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

ECHO " columns: CTRATAB  ic(1=APOL,2=NONE,3=WIMS)  dca  k-inf" ;

EVALUATE ic := 0 ;
WHILE ic 3 < DO
EVALUATE ic := ic 1 + ;
  EVALUATE iv := 0 ;
  WHILE iv ndc < DO
    EVALUATE iv := iv 1 + ;
    GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;
    IF ic 1 = THEN
      LIBRARY := RbmkLib  :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
    ELSEIF ic 2 = THEN
      LIBRARY := RbmkLibN :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
    ELSE
      LIBRARY := RbmkLibW :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
    ENDIF ;
    LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 ;
    SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
    FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
    GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
    ECHO "CTRATAB" ic dca kinf ;
    LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
  ENDWHILE ;
ENDWHILE ;

ECHO "rbmk_ctra completed" ;
END: ;
QUIT .
