*----
*  RBMK-1000 -- PROBE: which chain isotopes will EDI: refuse to lump?
*
*  EDILUM.f:230-254 aborts if a lumped isotope has max fission yield > 1 %%
*  AND is either stable or has a half-life > 30 days.  The offending name is
*  printed one at a time, so this deck is driven in a loop by a shell script
*  that appends each name and re-runs until it passes.  The resulting list is
*  the minimum MICR list for rbmk_a5b_compo.x2m.
*
*  Fresh fuel is sufficient: the check is on the depletion chain, not on
*  densities.  THROWAWAY -- delete once A5b's MICR list is settled.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX EDIOBJ ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: EDI: END: ;
PROCEDURE   RbmkLib ;

GEOSS := GEO: :: CARCEL 5
  EDIT 0
  X- REFL X+ REFL MESHX -12.5 12.5
  Y- REFL Y+ REFL MESHY -12.5 12.5
  RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
  MIX     1        2      3      4      5      5
  CLUSTER CARR ROD1 ROD2
  ::: CARR := GEO: TUBE 2
    MIX  1 9   NPIN 1  RPIN 0.00  APIN 0.00
    RADIUS 0.0000 0.5000 0.6500 ;
  ::: ROD1 := GEO: TUBE 4
    MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
    RADIUS 0.0000 0.1000 0.5750 0.5975 0.6800 ;
  ::: ROD2 := GEO: ROD1
    MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
  ;
GEOFL := GEO: GEOSS :: SPLITR 4 1 1 2 6
  ::: CARR := GEO: CARR SPLITR 1 1 ;
  ::: ROD1 := GEO: ROD1 SPLITR 1 3 1 1 ;
  ::: ROD2 := GEO: ROD2 SPLITR 1 3 1 1 ;
  ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 ALLG BATCH 100 TISO 8 15.0 ;
TRK   FTRK   := NXT: GEOFL :: EDIT 0 ALLG BATCH 100 TISO 15 30.0 ;

LIBRARY := RbmkLib :: 0.72 900.0 750.0 573.0 ;
LIBSS   := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
SYS     := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX    := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;

EDIOBJ := EDI: LIBSS TRK FLUX GEOFL SYS ::
  EDIT 0
  MICR 31
            U234    U235    U236    U238    Np237   Np239   Pu238   Pu239   Pu240   Pu241
            Pu242   Am241   Am242m  Am243   Cm242   Cm243   Cm244   Xe135   I135    Sm149
            Pm149   Sm151   Nd143   Rh103   Cs133   Tc99    Gd155   Gd157   Eu153   B10
            Ru103
  MERG COMP
  COND 0.625
  SAVE ON EDIRBMK
  ;

END: ;
QUIT .
