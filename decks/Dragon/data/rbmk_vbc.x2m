*----
*  Reduce the vacuum-boundary fault to its smallest case.  Varies slab
*  length, transverse height, and whether the CAR2D carries its own
*  MESHX/MESHY -- the CPS supercells omit it and are correct, while these
*  reflector geometries added it.  GENERATED by a one-off; kept.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: END: ;
PROCEDURE   RbmkLib RbmkVa RbmkVb RbmkVc RbmkVd ;
REAL tgnom := 750.0 ;
REAL tcool := 573.0 ;
REAL kinf ;

GEOSS GEOFL := RbmkVa :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'S' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'F' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "VBC 1x1 VOID, with MESHX" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;
GEOSS GEOFL := RbmkVb :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'S' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'F' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "VBC 1x1 VOID, no MESHX" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;
GEOSS GEOFL := RbmkVc :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'S' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'F' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "VBC 4x1 VOID, no MESHX" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;
GEOSS GEOFL := RbmkVd :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'S' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'F' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "VBC 4x2 VOID, no MESHX" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;

ECHO "rbmk_vbc completed" ;
END: ;
QUIT .
