*----
*  RBMK-1000 -- ISOLATE THE THERMAL SCATTERING TREATMENT OF COOLANT HYDROGEN
*
*  rbmk_proc/RbmkLib.c2m specifies coolant hydrogen as bare "H1", which is
*  FREE-GAS hydrogen.  Every bundled reference deck in this distribution
*  (twlup_proc/*.c2m, rep900_mco_proc/*.c2m) uses "H1_H2O", the bound
*  thermal-scattering evaluation, and DLIB_99 contains both.
*
*  An independent OpenMC model of the same cell (openmc/rbmk_cell.py), which
*  applies c_H_in_H2O, disagreed with the A5 result by an order of magnitude
*  on the fresh-fuel void reactivity, and disagreed on its SHAPE:
*      void      OpenMC ENDF/B-VIII.0     DRAGON A5 (bare H1)
*      51.4%        +548 +/- 7 pcm           +226 pcm
*      97.2%        +887 +/- 7 pcm           + 82 pcm
*  OpenMC rises monotonically with void; DRAGON turns over.
*
*  This deck runs the SAME cell at three coolant densities under each
*  hydrogen treatment.  Both branches call a procedure -- RbmkLibF for free
*  gas, RbmkLib for bound -- so the compositions are not retyped here and
*  the two procedure files differ in one line.
*
*  2026-09-23: the defect this deck found has been FIXED.  RbmkLib.c2m now
*  uses bound H1_H2O, and the free-gas composition it used to carry was
*  preserved as RbmkLibF.c2m so this comparison still reproduces.  Branch
*  ih=1 is therefore the historical (wrong) treatment and ih=2 is current.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLibF RbmkLib RbmkGeo ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 3 ;
INTEGER iv ih ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.35 0.02 ;

*==============================================================
*  GEOMETRY AND TRACKING -- identical to rbmk_cell_a3.x2m,
*  built once and reused for every case
*==============================================================
*  Both geometries come from rbmk_proc/RbmkGeo.c2m, the single source of
*  truth for the cell -- see its header for every dimension and source.
GEOSS GEOFL := RbmkGeo ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'H2O-TEST-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'H2O-TEST-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

ECHO "=====================================================" ;
ECHO " H1 (free gas) vs H1_H2O (bound)  --  RBMK cell k-inf" ;
ECHO " columns: H2OTAB  ih(1=H1,2=H1_H2O)  dca  k-inf" ;
ECHO "=====================================================" ;

EVALUATE ih := 0 ;
WHILE ih 2 < DO
EVALUATE ih := ih 1 + ;
  EVALUATE iv := 0 ;
  WHILE iv ndc < DO
    EVALUATE iv := iv 1 + ;
    GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;

    IF ih 1 = THEN
      LIBRARY := RbmkLibF :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
    ELSE
      LIBRARY := RbmkLib  :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
    ENDIF ;

    LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
    SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
    FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
    GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
    ECHO "H2OTAB" ih dca kinf ;

    LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
  ENDWHILE ;
ENDWHILE ;

ECHO "rbmk_h2otest completed" ;
END: ;
QUIT .
