* Raw DRAGON stdin (not an .x2m -- no .access hook, so no $1 to hang a path off).
* Paths below are repo-relative: run from the repository root, e.g.
*   install/bin/dragon < decks/Dragon/data/test_lib2.dra
* Test LIB: module to read HDF5 library

LINKED_LIST LIBRARY ;
MODULE LIB: END: ;

LIBRARY := LIB: ::
  EDIT 1
  NMIX 10
  ANIS 1
  MIXS LIB: DRAGON FIL: 'libraries/hdf5/gal_xs_99g.h5'
  MIX 1 293.0
