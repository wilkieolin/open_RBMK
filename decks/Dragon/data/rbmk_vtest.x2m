*----
*  WHY IS DRAGON'S VACUUM-FACE SLAB WRONG?
*  OpenMC says the 4-cell slab with one vacuum face is k = 1.198872 +/- 59 pcm
*  and DONJON diffusion says 1.191992; DRAGON says 0.849336, 34000 pcm out.
*  Reflected, all three agree.  So the fault is in how this calculation treats
*  the open boundary.  Two suspects, separated here: the B1 leakage model at
*  zero buckling sitting on top of a geometry that already leaks, and the
*  tracking density, since an open boundary needs tracks that actually reach
*  and cross it.  GENERATED by a one-off; kept because it found the bug.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: END: ;
PROCEDURE   RbmkLib RbmkScBare ;
REAL tgnom := 750.0 ;
REAL tcool := 573.0 ;
REAL kinf ;

GEOSS GEOFL := RbmkScBare :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'V-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'V-FL' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "VTEST B1-BUCK0 (TISO 15 30.0)" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;
GEOSS GEOFL := RbmkScBare :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'V-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'V-FL' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "VTEST plainK (TISO 15 30.0)" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;
GEOSS GEOFL := RbmkScBare :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'V-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'V-FL' ALLG BATCH 100 TISO 30 120.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "VTEST K-dense (TISO 30 120.0)" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;

ECHO "rbmk_vtest completed" ;
END: ;
QUIT .
