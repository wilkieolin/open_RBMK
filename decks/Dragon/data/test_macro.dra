* Test MAC: module with LINKED_LIST

LINKED_LIST MACRO GEOM TRK ASM FLUX ;
MODULE GEO: MAC: ASM: FLU: NXT: END: ;

MACRO := MAC: ::
  EDIT 2 NGRO 2 NMIX 1 NIFI 1
  READ INPUT
  MIX     1
      DIFFX  1.500E+00  4.000E-01
      TOTAL  3.000E-02  8.000E-02
     NUSIGF  0.000E+00  0.000E+00
   H-FACTOR  0.000E+00  0.000E+00
       SCAT  1 1 0.0  2 2 0.0  2.0E-02
  ;

GEOM := GEO: :: CARCEL 1 1 1
  EDIT 1
  X- REFL X+ REFL
  Y- REFL Y+ REFL
  RADIUS 0.0 1.0
  MIX 1
  ;

TRK := NXT: GEOM ::
  EDIT 1
  TITLE 'TEST'
  TISO 11 15.0
  ;

ASM := ASM: MACRO TRK :: EDIT 1 ;

FLUX := FLU: ASM TRK :: EDIT 2 EXTE 1.0E-6 ;

END: ;

QUIT .