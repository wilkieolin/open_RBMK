*----
*  RBMK-1000 -- IS "GRMIN 18" CORRECT FOR THE 172-GROUP LIBRARY?
*
*  GRMIN is a group INDEX, not an energy, so its correct value depends on the
*  library.  The bundled SHEM-295 decks use GRMIN 56; others use 45 or 52.
*  The RBMK decks inherited GRMIN 18 from rbmk_cell_dlib99.x2m and it has
*  never been checked against APOLIB-99.  USS: defaults IGRMIN to IPAR(9)+1,
*  which the library itself supplies (USS.f:134), so omitting the keyword is
*  the safe choice.
*
*  ig=1 : GRMIN 18 (what A3 and A5 use)   ig=2 : library default
*  Bound hydrogen throughout, so that variable is already fixed.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLib RbmkGeo ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 3 ;
INTEGER iv ig ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.35 0.02 ;

*  Both geometries come from rbmk_proc/RbmkGeo.c2m, the single source of
*  truth for the cell -- see its header for every dimension and source.
GEOSS GEOFL := RbmkGeo ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'GRMIN-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'GRMIN-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

ECHO " columns: GRMINTAB  ig(1=GRMIN 18, 2=default)  dca  k-inf" ;

EVALUATE ig := 0 ;
WHILE ig 2 < DO
EVALUATE ig := ig 1 + ;
  EVALUATE iv := 0 ;
  WHILE iv ndc < DO
    EVALUATE iv := iv 1 + ;
    GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;
    LIBRARY := RbmkLib  :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
    IF ig 1 = THEN
      LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
    ELSE
      LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 1 PASS 2 ;
    ENDIF ;
    SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
    FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
    GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
    ECHO "GRMINTAB" ig dca kinf ;
    LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
  ENDWHILE ;
ENDWHILE ;

ECHO "rbmk_grmin completed" ;
END: ;
QUIT .
