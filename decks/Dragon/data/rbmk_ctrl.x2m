*----
*  CONTROLS for the reflector work.  A fully reflected block of fuel cells
*  must reproduce the fuel cell's own k-inf of 1.313968, whatever the block
*  size, because reflecting an infinite lattice changes nothing.  If it does
*  not, the strip geometry or its tracking is at fault and the 16187 pcm
*  attributed to diffusion theory is misattributed.
*  GENERATED by a one-off; kept because it is the check that decides that.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: END: ;
PROCEDURE   RbmkLib RbmkScBareR RbmkScOne ;
REAL tgnom := 750.0 ;
REAL tcool := 573.0 ;
REAL kinf ;

GEOSS GEOFL := RbmkScBareR :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'C-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'C-FL' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "CTRL bare4-REFL" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;
GEOSS GEOFL := RbmkScOne :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'C-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'C-FL' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "CTRL one-REFL" kinf ;
GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX := DELETE:
  GEOSS GEOFL TRKSS TRK LIBRARY LIBSS SYS FLUX ;
FTRKSS FTRK := DELETE: FTRKSS FTRK ;

ECHO "rbmk_ctrl completed" ;
END: ;
QUIT .
