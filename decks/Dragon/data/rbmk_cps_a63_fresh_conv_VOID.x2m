*----
*  A6.2 / A6.3 CPS supercell -- a63_fresh_conv_VOID
*  fuel library RbmkLibZN2, supercell mesh x4  (flux: MOC, P1, CTRA NONE)
*  B4C nom (2.0 g/cm3), displacer nom (1.65 g/cm3), T_dsp nom
*  CPS water at 323.15 K
*  GENERATED by openmc/cps_common.py -- edit that, not this file.
*  Output:  CPSTAB <bu> <dca> <tf> <itype> <k-inf>  itype 1=FUEL 2=WAT 3=ABS 4=DSP 5=VOID
*           CPSCELL <bu> <dca> <tf> <k-inf>   single fuel cell, production settings
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX BURNUP
            SCSS SCFL SCTRKSS SCTRK EDIMIX MACMIX ;
SEQ_BINARY  FTRKSS FTRK SCFTRKSS SCFTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: EVO: EDI: GREP: DELETE: ABORT: END: MCCGT: ;
PROCEDURE   RbmkLibZN2 RbmkLib RbmkGeo
            RbmkCpsLib RbmkScVOID ;
REAL tgnom := 750.0 ;
REAL tcool := 573.0 ;
REAL fpwr  := 16.7 ;
REAL b4c := 2.0 ;
REAL dsp := 1.65 ;
REAL tdsp := 323.15 ;
REAL twat := 323.15 ;
REAL kinf tbeg tend vol ;

*--- single fuel cell: production depletion at the nominal state (as rbmk_a5b_compo)
GEOSS GEOFL := RbmkGeo ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'CELL-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'CELL-FL' ALLG BATCH 100 TISO 15 30.0 ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
EVALUATE tend := 0.0 ;
BURNUP LIBSS := EVO: LIBSS FLUX TRK :: EDIT 0 SAVE <<tend>> DAY POWR <<fpwr>> ;
LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;

*=== supercell, centre VOID
SCSS SCFL := RbmkScVOID :: 4 ;
SCTRKSS SCFTRKSS := NXT: SCSS :: EDIT 0 TITLE 'SC-SS' ALLG BATCH 100 TISO 8 15.0 ;
SCTRK SCFTRK := NXT: SCFL :: EDIT 0 TITLE 'SC-FL' ALLG BATCH 100 ANIS 2 TISO 30 120.0 ;
SCTRK := MCCGT: SCTRK SCFTRK SCFL ::
  EDIT 0 LCMD 3 MAXI 1 EPSI 1E-5 HDD 0. MCU 400000 KRYL 0 SCR 0 AAC 100 TMT ;
LIBRARY := RbmkLibZN2 :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBRARY := RbmkCpsLib LIBRARY :: <<b4c>> <<dsp>> <<tdsp>> <<twat>> ;
LIBSS := USS: LIBRARY SCTRKSS SCFTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS SCTRK SCFTRK :: EDIT 0 ARM ;
FLUX := FLU: LIBSS SCTRK SCFTRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "CPSTAB" 0.0 0.72 900.0 5 kinf ;
EDIMIX := EDI: LIBSS SCTRK FLUX SCFL SYS :: EDIT 0 MICR ALL
  MERG MIX 1 2 3 4 5 6 7 8 9 0 0 0 0 10 11 SAVE ON MIXED ;
MACMIX := EDIMIX :: STEP UP MIXED ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 1 >>vol<< ;
IF vol 180.00616 < THEN
  ECHO "FAIL: VOID MIX 1 area" vol "expected 180.18635" ; ABORT: ; ENDIF ;
IF vol 180.36653 > THEN
  ECHO "FAIL: VOID MIX 1 area" vol "expected 180.18635" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 2 >>vol<< ;
IF vol 84.36156 < THEN
  ECHO "FAIL: VOID MIX 2 area" vol "expected 84.44601" ; ABORT: ; ENDIF ;
IF vol 84.53046 > THEN
  ECHO "FAIL: VOID MIX 2 area" vol "expected 84.44601" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 3 >>vol<< ;
IF vol 47.68217 < THEN
  ECHO "FAIL: VOID MIX 3 area" vol "expected 47.72990" ; ABORT: ; ENDIF ;
IF vol 47.77763 > THEN
  ECHO "FAIL: VOID MIX 3 area" vol "expected 47.72990" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 4 >>vol<< ;
IF vol 332.95043 < THEN
  ECHO "FAIL: VOID MIX 4 area" vol "expected 333.28371" ; ABORT: ; ENDIF ;
IF vol 333.61699 > THEN
  ECHO "FAIL: VOID MIX 4 area" vol "expected 333.28371" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 5 >>vol<< ;
IF vol 4701.66053 < THEN
  ECHO "FAIL: VOID MIX 5 area" vol "expected 4706.36689" ; ABORT: ; ENDIF ;
IF vol 4711.07326 > THEN
  ECHO "FAIL: VOID MIX 5 area" vol "expected 4706.36689" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 6 >>vol<< ;
IF vol 48.30076 < THEN
  ECHO "FAIL: VOID MIX 6 area" vol "expected 48.34911" ; ABORT: ; ENDIF ;
IF vol 48.39746 > THEN
  ECHO "FAIL: VOID MIX 6 area" vol "expected 48.34911" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 7 >>vol<< ;
IF vol 96.60152 < THEN
  ECHO "FAIL: VOID MIX 7 area" vol "expected 96.69822" ; ABORT: ; ENDIF ;
IF vol 96.79492 > THEN
  ECHO "FAIL: VOID MIX 7 area" vol "expected 96.69822" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 8 >>vol<< ;
IF vol 53.69734 < THEN
  ECHO "FAIL: VOID MIX 8 area" vol "expected 53.75109" ; ABORT: ; ENDIF ;
IF vol 53.80484 > THEN
  ECHO "FAIL: VOID MIX 8 area" vol "expected 53.75109" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 9 >>vol<< ;
IF vol 13.35411 < THEN
  ECHO "FAIL: VOID MIX 9 area" vol "expected 13.36748" ; ABORT: ; ENDIF ;
IF vol 13.38084 > THEN
  ECHO "FAIL: VOID MIX 9 area" vol "expected 13.36748" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 10 >>vol<< ;
IF vol 8.00305 < THEN
  ECHO "FAIL: VOID MIX 14 area" vol "expected 8.01106" ; ABORT: ; ENDIF ;
IF vol 8.01907 > THEN
  ECHO "FAIL: VOID MIX 14 area" vol "expected 8.01106" ; ABORT: ; ENDIF ;
GREP: MACMIX :: GETVAL 'MIXTURESVOL' 11 >>vol<< ;
IF vol 52.75736 < THEN
  ECHO "FAIL: VOID MIX 15 area" vol "expected 52.81017" ; ABORT: ; ENDIF ;
IF vol 52.86298 > THEN
  ECHO "FAIL: VOID MIX 15 area" vol "expected 52.81017" ; ABORT: ; ENDIF ;
ECHO "supercell VOID volume guardrail PASSED (11 mixtures)" ;
EDIMIX MACMIX := DELETE: EDIMIX MACMIX ;
LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
LIBRARY := RbmkLibZN2 :: 0.02 900.0 <<tgnom>> <<tcool>> ;
LIBRARY := RbmkCpsLib LIBRARY :: <<b4c>> <<dsp>> <<tdsp>> <<twat>> ;
LIBSS := USS: LIBRARY SCTRKSS SCFTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS SCTRK SCFTRK :: EDIT 0 ARM ;
FLUX := FLU: LIBSS SCTRK SCFTRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "CPSTAB" 0.0 0.02 900.0 5 kinf ;
LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
SCSS SCFL SCTRKSS SCTRK SCFTRKSS SCFTRK := DELETE: SCSS SCFL SCTRKSS SCTRK SCFTRKSS SCFTRK ;

ECHO "rbmk_cps_a63_fresh_conv_VOID completed" ;
END: ;
QUIT .
