*----
*  RBMK-1000 -- HOW MUCH OF THE VOID COEFFICIENT COMES FROM SELF-SHIELDING?
*
*  Fixing coolant hydrogen from free-gas H1 to bound H1_H2O raised the
*  full-void reactivity from +82 to +222 pcm, but an independent OpenMC
*  model of the same cell gives +887 pcm.  So the H2O treatment explains
*  only ~17% of the gap and something else dominates.
*
*  Voiding hardens the spectrum, which raises epithermal flux and hence
*  U-238 resonance capture.  If DRAGON's subgroup self-shielding mis-states
*  how much that capture grows on voiding, it lands directly on the void
*  coefficient.  This deck runs the same cell with self-shielding ON (USS:)
*  and OFF (infinite dilution) at each density.  The absolute k-inf with
*  self-shielding off is meaningless -- only the CHANGE in void reactivity
*  between the two is being measured.
*
*  Bound hydrogen (RbmkLib ) throughout, so the H2O question is already
*  settled and out of the way.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLib RbmkGeo ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 3 ;
INTEGER iv iss ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.35 0.02 ;

*  Both geometries come from rbmk_proc/RbmkGeo.c2m, the single source of
*  truth for the cell -- see its header for every dimension and source.
GEOSS GEOFL := RbmkGeo ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'SS-TEST-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'SS-TEST-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

ECHO "=====================================================" ;
ECHO " self-shielding ON vs OFF  --  RBMK cell k-inf" ;
ECHO " columns: SSTAB  iss(1=USS:,2=infinite dilution) dca k-inf" ;
ECHO "=====================================================" ;

EVALUATE iss := 0 ;
WHILE iss 2 < DO
EVALUATE iss := iss 1 + ;
  EVALUATE iv := 0 ;
  WHILE iv ndc < DO
    EVALUATE iv := iv 1 + ;
    GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;
    LIBRARY := RbmkLib  :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;

    IF iss 1 = THEN
      LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
      SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
      FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
      LIBSS := DELETE: LIBSS ;
    ELSE
      SYS   := ASM: LIBRARY TRK FTRK :: EDIT 0 ;
      FLUX  := FLU: LIBRARY TRK SYS :: TYPE K EXTE 1.0E-6 ;
    ENDIF ;

    GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
    ECHO "SSTAB" iss dca kinf ;
    LIBRARY SYS FLUX := DELETE: LIBRARY SYS FLUX ;
  ENDWHILE ;
ENDWHILE ;

ECHO "rbmk_sstest completed" ;
END: ;
QUIT .
