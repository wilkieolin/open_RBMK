*----
*  RBMK-1000  --  A5: VOID COEFFICIENT vs BURNUP
*
*  WHY BURNUP IS IN THE LOOP
*  The A5 gate in TIER_A_WORKPLAN.md asked for a positive void coefficient at
*  zero burnup.  That is the wrong test.  The RBMK's positive void coefficient
*  is a high-burnup phenomenon: it needs the Pu-239 inventory, whose 0.3 eV
*  fission resonance is what makes spectrum hardening reactivity-positive.
*  A fresh, unpoisoned, low-enrichment cell can legitimately come out negative.
*  Historically the coefficient also climbed as the fixed absorbers were
*  withdrawn during burn-in.  So the coefficient is reported here as a function
*  of burnup, and the gate is applied at operating burnup, not at zero.
*
*  Cell geometry and materials: see rbmk_cell_a3.x2m and rbmk_proc/RbmkLib.c2m.
*  Specific power 16.7 MW/t  (3200 MWth / 192 t U).
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX BURNUP DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: EVO: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLib ;

REAL tfuel := 900.0 ;   ! K
REAL tgrap := 750.0 ;   ! K
REAL tcool := 573.0 ;   ! K
REAL dnom  := 0.72 ;    ! nominal coolant density, g/cm3
REAL fpwr  := 16.7 ;    ! MW per tonne of initial heavy metal

INTEGER nbu := 7 ;
INTEGER ndc := 3 ;
INTEGER istep iv ;
REAL bubeg buend tbeg tend dbr kref kbr rho pcmpv voidpc ;

DONNEES := UTL: :: CREA 'burn' <<nbu>> =
   0.0   500.0  2000.0  5000.0  10000.0  15000.0  20000.0 ;
DONNEES := UTL: DONNEES :: CREA 'dca' <<ndc>> =
   0.72  0.35   0.02 ;

*==============================================================
*  GEOMETRY AND TRACKING  (identical to rbmk_cell_a3.x2m)
*==============================================================
GEOSS := GEO: :: CARCEL 5
  EDIT 0
  X- REFL X+ REFL MESHX -12.5 12.5
  Y- REFL Y+ REFL MESHY -12.5 12.5
  RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
  MIX     1        2      3      4      5      5
  CLUSTER CARR ROD1 ROD2
  ::: CARR := GEO: TUBE 3
    MIX  9 1 9   NPIN 1  RPIN 0.00  APIN 0.00
    RADIUS 0.0000 0.6000 0.6250 0.7500 ;
  ::: ROD1 := GEO: TUBE 4
    MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
    RADIUS 0.0000 0.1000 0.5750 0.5850 0.6750 ;
  ::: ROD2 := GEO: ROD1
    MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
  ;
GEOFL := GEO: GEOSS :: SPLITR 4 1 1 2 6
  ::: CARR := GEO: CARR SPLITR 1 1 1 ;
  ::: ROD1 := GEO: ROD1 SPLITR 1 3 1 1 ;
  ::: ROD2 := GEO: ROD2 SPLITR 1 3 1 1 ;
  ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'RBMK-A5-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK   FTRK   := NXT: GEOFL ::
  EDIT 0 TITLE 'RBMK-A5-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

*==============================================================
*  REFERENCE DEPLETION AT NOMINAL COOLANT DENSITY
*==============================================================
ECHO "=== reference depletion, dca =" dnom "g/cm3 ===" ;

LIBRARY := RbmkLib :: <<dnom>> <<tfuel>> <<tgrap>> <<tcool>> ;
LIBSS   := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
SYS     := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX    := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kref<< ;
ECHO "BU(MWd/t) 0.0   k-inf" kref ;

EVALUATE tend := 0.0 ;
BURNUP LIBSS := EVO: LIBSS FLUX TRK ::
  EDIT 0 SAVE <<tend>> DAY POWR <<fpwr>> ;

EVALUATE istep := 1 ;
WHILE istep nbu < DO
  EVALUATE istep := istep 1 + ;
  EVALUATE bubeg tbeg := buend tend ;
  GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
  EVALUATE tend := buend fpwr / ;

  BURNUP LIBSS := EVO: BURNUP LIBSS FLUX TRK ::
    EDIT 0 NOEX DEPL <<tbeg>> <<tend>> DAY POWR <<fpwr>> ;

  SYS  := DELETE: SYS ;
  SYS  := ASM: LIBSS TRK FTRK :: EDIT 0 ;
  FLUX := FLU: FLUX LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
  GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kref<< ;
  ECHO "BU(MWd/t)" buend "  k-inf" kref ;

  BURNUP LIBSS := EVO: BURNUP LIBSS FLUX TRK ::
    EDIT 0 SAVE <<tend>> DAY POWR <<fpwr>> ;
ENDWHILE ;

*==============================================================
*  VOID BRANCHES AT EACH SAVED BURNUP POINT
*
*  At each burnup step the fresh library is rebuilt at the branch coolant
*  density, the depleted fuel isotopics are restored from the BURNUP object
*  (LIB: ... BURN n MIX 6 MIX 7), and the cell is re-self-shielded and
*  re-solved.  Re-doing USS: per branch matters: voiding hardens the spectrum
*  into the U-238 resonances, and that is precisely where self-shielding acts.
*==============================================================
ECHO "" ;
ECHO "=====================================================" ;
ECHO " VOID COEFFICIENT vs BURNUP" ;
ECHO " columns: BU(MWd/t)  dca(g/cm3)  void%  k-inf  drho(pcm)  pcm/%void" ;
ECHO "=====================================================" ;

EVALUATE istep := 0 ;
WHILE istep nbu < DO
  EVALUATE istep := istep 1 + ;
  GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;

* reference k-inf at this burnup, nominal density
  LIBRARY := DELETE: LIBRARY ;
  LIBRARY := RbmkLib :: <<dnom>> <<tfuel>> <<tgrap>> <<tcool>> ;
  LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
  LIBSS   := DELETE: LIBSS ;
  LIBSS   := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
  SYS     := DELETE: SYS ;
  SYS     := ASM: LIBSS TRK FTRK :: EDIT 0 ;
  FLUX    := DELETE: FLUX ;
  FLUX    := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
  GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kref<< ;

  EVALUATE iv := 1 ;
  WHILE iv ndc < DO
    EVALUATE iv := iv 1 + ;
    GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dbr<< ;

    LIBRARY := DELETE: LIBRARY ;
    LIBRARY := RbmkLib :: <<dbr>> <<tfuel>> <<tgrap>> <<tcool>> ;
    LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
    LIBSS   := DELETE: LIBSS ;
    LIBSS   := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
    SYS     := DELETE: SYS ;
    SYS     := ASM: LIBSS TRK FTRK :: EDIT 0 ;
    FLUX    := DELETE: FLUX ;
    FLUX    := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
    GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kbr<< ;

    EVALUATE voidpc := dnom dbr - dnom / 100.0 * ;
    EVALUATE rho    := kbr kref - kbr kref * / 100000.0 * ;
    EVALUATE pcmpv  := rho voidpc / ;
    ECHO "VOIDTAB" buend dbr voidpc kbr rho pcmpv ;
  ENDWHILE ;
ENDWHILE ;

END: ;
QUIT "LIST" .
