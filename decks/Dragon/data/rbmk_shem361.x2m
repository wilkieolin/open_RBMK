*----
*  RBMK-1000 -- IS THE 172-GROUP STRUCTURE THE PROBLEM?
*
*  With hydrogen treatment (H1_H2O) and nuclear data (ENDF/B-VIII.1) matched,
*  DRAGON and OpenMC still differ by 4x on the full-void reactivity:
*      dca 0.72 -> 0.02 :  DRAGON +222 pcm,  OpenMC +912 pcm
*
*  The exact decomposition (k = nu-fission / absorption) puts essentially all
*  of it in the PRODUCTION term, and within that, in U-235:
*      U-235 nu-fission on voiding :  DRAGON -0.200 pp,  OpenMC +0.746 pp
*      U-238 nu-fission on voiding :  DRAGON +0.494 pp,  OpenMC +0.452 pp
*  Both codes harden the spectrum the same way; they disagree on whether the
*  epithermal U-235 fission gain beats the thermal U-235 fission loss.  That
*  is a question about resolution in the resonance range.
*
*  This deck is the same cell, same compositions, same everything, run on
*  SHEM-361 instead of the 172-group APOLIB-99 structure -- same ENDF/B-VIII.1
*  evaluation, 2.1x the groups, and a far finer mesh through the resolved
*  resonances.  The access script swaps the library; nothing else changes.
*
*  If k-inf and the void reactivity move toward OpenMC, the group structure
*  is the cause.  If they do not, the cause is the self-shielding method and
*  a finer mesh will not fix it.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLib RbmkGeo ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 3 ;
INTEGER iv ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.35 0.02 ;

*  Both geometries come from rbmk_proc/RbmkGeo.c2m, the single source of
*  truth for the cell -- see its header for every dimension and source.
GEOSS GEOFL := RbmkGeo ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'SHEM-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'SHEM-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

ECHO "=====================================================" ;
ECHO " SHEM-361 structure, bound hydrogen, ENDF/B-VIII.1" ;
ECHO " columns: SHEMTAB  dca  k-inf" ;
ECHO "=====================================================" ;

EVALUATE iv := 0 ;
WHILE iv ndc < DO
  EVALUATE iv := iv 1 + ;
  GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;
  LIBRARY := RbmkLib  :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
  LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 1 TRAN PASS 4 NOCO ;
  SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
  FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
  GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
  ECHO "SHEMTAB" dca kinf ;
  LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
ENDWHILE ;

ECHO "rbmk_shem361 completed" ;
END: ;
QUIT .
