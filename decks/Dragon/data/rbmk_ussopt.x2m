*----
*  RBMK-1000 -- HOW SENSITIVE IS THE VOID COEFFICIENT TO USS: OPTIONS?
*
*  Header corrected 2026-09-23 -- it had been copy-pasted from rbmk_grmin.x2m
*  and described that deck's experiment, not this one.
*
*  This deck varies the USS: SOLUTION OPTIONS, holding GRMIN at the library
*  default in both branches (rbmk_grmin.x2m separately showed GRMIN 18 to be
*  bit-identical to the default on this library, so it is not a variable).
*
*    ig=1 : PASS 2                -- the default iteration scheme
*    ig=2 : TRAN PASS 4 NOCO      -- transport-corrected subgroup flux, four
*                                    passes, no correlation between resonant
*                                    isotopes
*
*  Measured effect: < 0.5 pcm.  Recorded in PROGRESS.md as eliminated.
*  Bound hydrogen throughout (RbmkLib since 2026-09-23).
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: UTL: END: ;
PROCEDURE   RbmkLib ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 3 ;
INTEGER iv ig ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.35 0.02 ;

GEOSS := GEO: :: CARCEL 5
  EDIT 0
  X- REFL X+ REFL MESHX -12.5 12.5
  Y- REFL Y+ REFL MESHY -12.5 12.5
  RADIUS  0.00     4.00   4.40   4.55   5.70   11.00
  MIX     1        2      3      4      5      5
  CLUSTER CARR ROD1 ROD2
  ::: CARR := GEO: TUBE 2
    MIX  1 9   NPIN 1  RPIN 0.00  APIN 0.00
    RADIUS 0.0000 0.5000 0.6500 ;
  ::: ROD1 := GEO: TUBE 4
    MIX  3 6 3 8   NPIN 6  RPIN 1.60  APIN 0.00
    RADIUS 0.0000 0.1000 0.5750 0.5975 0.6800 ;
  ::: ROD2 := GEO: ROD1
    MIX  3 7 3 8   NPIN 12  RPIN 3.10  APIN 0.261799 ;
  ;
GEOFL := GEO: GEOSS :: SPLITR 4 1 1 2 6
  ::: CARR := GEO: CARR SPLITR 1 1 ;
  ::: ROD1 := GEO: ROD1 SPLITR 1 3 1 1 ;
  ::: ROD2 := GEO: ROD2 SPLITR 1 3 1 1 ;
  ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'GRMIN-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'GRMIN-FLUX' ALLG BATCH 100 TISO 15 30.0 ;

ECHO " columns: USSTAB  io(1=PASS 2 GRMIN 18 [A3+A5], 2=TRAN PASS 4 NOCO)  dca  k-inf" ;

EVALUATE ig := 0 ;
WHILE ig 2 < DO
EVALUATE ig := ig 1 + ;
  EVALUATE iv := 0 ;
  WHILE iv ndc < DO
    EVALUATE iv := iv 1 + ;
    GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;
    LIBRARY := RbmkLib  :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
    IF ig 1 = THEN
      LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 GRMIN 18 ;
    ELSE
      LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 1 TRAN PASS 4 NOCO ;
    ENDIF ;
    SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
    FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
    GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
    ECHO "USSTAB" ig dca kinf ;
    LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
  ENDWHILE ;
ENDWHILE ;

ECHO "rbmk_ussopt completed" ;
END: ;
QUIT .
