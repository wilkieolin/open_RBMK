*----
*  CANDU-6 CELL -- CONTROL TEST FOR THE DRAGON/OpenMC VOID COMPARISON
*
*  DRAGON and OpenMC disagree by 4x on the RBMK void coefficient with
*  geometry, composition, hydrogen treatment and nuclear data all matched.
*  Everything adjustable inside the DRAGON input accounts for only ~220 of
*  the ~830 pcm.  Before calling the remainder a real method difference, the
*  OpenMC setup has to be checked on a lattice that is NOT the RBMK.
*
*  Geometry is twlup_proc/TCWU07.c2m verbatim -- the bundled CANDU-6 cell,
*  which is cluster-geometry, non-light-water-moderated, low-enrichment, and
*  has a coolant-void branch.  TCWU07 runs on the IAEA WLUP library, which
*  OpenMC cannot read, so this runs on DLIB_99 in both codes instead; the
*  WLUP asserted values (1.112290 / 1.131289, +1510 pcm) therefore do not
*  apply here.  What is under test is whether the two codes agree WITH EACH
*  OTHER away from the RBMK.
*
*  Compositions come from rbmk_proc/CanduLib.c2m, generated together with
*  the OpenMC materials by openmc/candu_common.py, so a transcription error
*  lands in both codes and cancels.
*
*  iv=1 nominal coolant   iv=2 coolant voided (MIX 0, as TCWU07 does it)
*----
LINKED_LIST LIBRARY LIBSS CANDU6S CANDU6T CANDU6SV CANDU6TV
            TRKSS TRK SYS FLUX LIBSSV TRKSSV TRKV SYSV FLUXV ;
SEQ_BINARY  FTRKSS FTRK FTRKSSV FTRKV ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: END: ;
PROCEDURE   CanduLib ;

REAL kinf kinfv ;

LIBRARY := CanduLib ;

CANDU6S := GEO: :: CARCEL 5
  EDIT 0
  X+ REFL X- REFL MESHX -14.2875 14.2875
  Y+ REFL Y- REFL MESHY -14.2875 14.2875
  RADIUS  0.00000 5.16890 5.60320 6.44780 6.58750 14.00
  MIX     1       2       3       4       5       5
  CLUSTER ROD1 ROD2 ROD3 ROD4
  ::: ROD1 := GEO: TUBE 2 MIX  6 10 NPIN  1 RPIN 0.0000 APIN 0.0000
    RADIUS 0.00000 0.6122 0.6540 ;
  ::: ROD2 := GEO: ROD1   MIX  7 10 NPIN  6 RPIN 1.4885 APIN 0.0000   ;
  ::: ROD3 := GEO: ROD1   MIX  8 10 NPIN 12 RPIN 2.8755 APIN 0.261799 ;
  ::: ROD4 := GEO: ROD1   MIX  9 10 NPIN 18 RPIN 4.3305 APIN 0.0      ;
  ;
CANDU6T := GEO: CANDU6S :: SPLITR  6 1 1  1 10
  ::: ROD1 := GEO: ROD1 SPLITR 2 1 ;
  ::: ROD2 := GEO: ROD2 SPLITR 2 1 ;
  ::: ROD3 := GEO: ROD3 SPLITR 2 1 ;
  ::: ROD4 := GEO: ROD4 SPLITR 2 1 ;
  ;
CANDU6SV := GEO: CANDU6S  :: MIX 0 2 3 4 5 5 ;
CANDU6TV := GEO: CANDU6SV :: SPLITR  6 1 1  1 10
  ::: ROD1 := GEO: ROD1 SPLITR 2 1 ;
  ::: ROD2 := GEO: ROD2 SPLITR 2 1 ;
  ::: ROD3 := GEO: ROD3 SPLITR 2 1 ;
  ::: ROD4 := GEO: ROD4 SPLITR 2 1 ;
  ;

ECHO " columns: CANDUTAB  iv(1=nominal,2=voided)  k-inf" ;

*  Unrolled rather than looped: a SEQ_BINARY tracking file cannot simply be
*  reassigned on a second pass (cle2000: SEQ_BINARY *FTRKSS* ALREADY EXISTS),
*  so the two cases get their own tracking objects.

*  --- nominal coolant ---
TRKSS FTRKSS := NXT: CANDU6S ::
  EDIT 0 TITLE 'CANDU-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: CANDU6T ::
  EDIT 0 TITLE 'CANDU-FLUX' ALLG BATCH 100 TISO 15 30.0 ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 ;
SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX  := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "CANDUTAB 1" kinf ;

*  --- coolant voided (MIX 0, exactly as TCWU07 does it) ---
TRKSSV FTRKSSV := NXT: CANDU6SV ::
  EDIT 0 TITLE 'CANDU-SS-V' ALLG BATCH 100 TISO 8 15.0 ;
TRKV FTRKV := NXT: CANDU6TV ::
  EDIT 0 TITLE 'CANDU-FLUX-V' ALLG BATCH 100 TISO 15 30.0 ;
LIBSSV := USS: LIBRARY TRKSSV FTRKSSV :: EDIT 0 PASS 2 ;
SYSV   := ASM: LIBSSV TRKV FTRKV :: EDIT 0 ;
FLUXV  := FLU: LIBSSV TRKV SYSV :: TYPE K EXTE 1.0E-6 ;
GREP: FLUXV :: GETVAL 'K-INFINITY' 1 >>kinfv<< ;
ECHO "CANDUTAB 2" kinfv ;

ECHO "rbmk_candu completed" ;
END: ;
QUIT .
