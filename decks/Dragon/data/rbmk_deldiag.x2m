*----
*  Does DLIB_99 carry PER-ISOTOPE delayed-neutron data?
*
*  Written 2026-09-23 to settle a beta_eff extraction that came back constant
*  at 0.006524 for every burnup, void fraction and temperature -- visibly
*  wrong, since beta must fall as Pu-239 displaces U-235.
*
*  Answer: yes.  The microlib's LAMBDA-D grows 6 -> 12 -> 18 entries as fissile
*  isotopes are added (6 precursor groups per fissile isotope), and the delayed
*  fractions differ by a factor of three between them:
*
*     sum of the six beta_i   U-235  0.006524
*                             Pu-239 0.002254   (literature ~0.0021)
*
*  So the library was never the problem.  The bug was in the read:
*  GREP: ... GETVAL 'NAME' I [J [K]] takes a START INDEX, optional end, optional
*  stride (DRVGRP.f:182-190) -- not a count.  GETVAL 'NUSIGF' 1 returns element
*  1 alone, and with NBFIS = 18 fissile families in the depleted macrolib that
*  is U-235's entry in BOTH numerator and denominator, at every state.
*  Hence exactly U-235's beta, everywhere.  Use MEAN 'NUSIGF' 1 18: the common
*  factor 18 cancels in the ratio.
*
*  Read NUSIGF and NUSIGF01..06 at thermal group 172 for each fissile isotope.
*----
LINKED_LIST LIBU ;
MODULE LIB: GREP: END: ;
REAL t1 t2 t3 d1 d2 d3 ;
LIBU := LIB: :: EDIT 0 NMIX 1 CTRA APOL ANIS 2
  MIXS LIB: DRAGON FIL: DLIB_99
  MIX 1 900.0
     U235  = U235  1.00000E-4
     Pu239 = Pu239 3.69750E-4
     U238  = U238  2.27272E-2
     O16   = O16   4.63940E-2
  ;
GREP: LIBU :: STEP UP 'MACROLIB' STEP UP 'GROUP' STEP AT 172
  GETVAL 'NUSIGF' 1 3 >>t1<< >>t2<< >>t3<< ;
ECHO "DD3 NUSIGF  U235" t1 " Pu239" t2 " U238" t3 ;
GREP: LIBU :: STEP UP 'MACROLIB' STEP UP 'GROUP' STEP AT 172
  GETVAL 'NUSIGF01' 1 3 >>d1<< >>d2<< >>d3<< ;
EVALUATE d1 := d1 t1 / ; EVALUATE d2 := d2 t2 / ;
ECHO "DD3 frac01  U235" d1 " Pu239" d2 ;
GREP: LIBU :: STEP UP 'MACROLIB' STEP UP 'GROUP' STEP AT 172
  GETVAL 'NUSIGF02' 1 3 >>d1<< >>d2<< >>d3<< ;
EVALUATE d1 := d1 t1 / ; EVALUATE d2 := d2 t2 / ;
ECHO "DD3 frac02  U235" d1 " Pu239" d2 ;
GREP: LIBU :: STEP UP 'MACROLIB' STEP UP 'GROUP' STEP AT 172
  GETVAL 'NUSIGF03' 1 3 >>d1<< >>d2<< >>d3<< ;
EVALUATE d1 := d1 t1 / ; EVALUATE d2 := d2 t2 / ;
ECHO "DD3 frac03  U235" d1 " Pu239" d2 ;
GREP: LIBU :: STEP UP 'MACROLIB' STEP UP 'GROUP' STEP AT 172
  GETVAL 'NUSIGF04' 1 3 >>d1<< >>d2<< >>d3<< ;
EVALUATE d1 := d1 t1 / ; EVALUATE d2 := d2 t2 / ;
ECHO "DD3 frac04  U235" d1 " Pu239" d2 ;
GREP: LIBU :: STEP UP 'MACROLIB' STEP UP 'GROUP' STEP AT 172
  GETVAL 'NUSIGF05' 1 3 >>d1<< >>d2<< >>d3<< ;
EVALUATE d1 := d1 t1 / ; EVALUATE d2 := d2 t2 / ;
ECHO "DD3 frac05  U235" d1 " Pu239" d2 ;
GREP: LIBU :: STEP UP 'MACROLIB' STEP UP 'GROUP' STEP AT 172
  GETVAL 'NUSIGF06' 1 3 >>d1<< >>d2<< >>d3<< ;
EVALUATE d1 := d1 t1 / ; EVALUATE d2 := d2 t2 / ;
ECHO "DD3 frac06  U235" d1 " Pu239" d2 ;
END: ;
QUIT .
