*----
*  Does MOC get the open boundary right where collision probability does not?
*  OpenMC: 4 fuel cells, one vacuum face = 1.198662 +/- 0.000691.
*  DRAGON CP (ASM: with NXT tracking, the default): 0.849315.
*  Here the same geometry is solved by the method of characteristics
*  (MCCGT: + ASM: ARM), the project's converged-method path.
*  GENERATED by a one-off; kept.
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: MCCGT: GREP: DELETE: END: ;
PROCEDURE   RbmkLib RbmkScBare ;
REAL tgnom := 750.0 ;
REAL tcool := 573.0 ;
REAL kinf ;

GEOSS GEOFL := RbmkScBare :: 1 ;
TRKSS FTRKSS := NXT: GEOSS :: EDIT 0 TITLE 'S' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL :: EDIT 0 TITLE 'F' ALLG BATCH 100 ANIS 2 TISO 15 30.0 ;
TRK := MCCGT: TRK FTRK GEOFL ::
  EDIT 0 LCMD 3 MAXI 1 EPSI 1E-5 HDD 0. MCU 400000 KRYL 0 SCR 0 AAC 100 TMT ;
LIBRARY := RbmkLib :: 0.72 900.0 <<tgnom>> <<tcool>> ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS := ASM: LIBSS TRK FTRK :: EDIT 0 ARM ;
FLUX := FLU: LIBSS TRK SYS :: TYPE K EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kinf<< ;
ECHO "MOC 4cell-void" kinf ;

ECHO "rbmk_moc completed" ;
END: ;
QUIT .
