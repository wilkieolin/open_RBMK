ECHO "A5BAXIS" buend dbr tfbr tgbr kinf ;

*--------------------------------------------------------------
*  BURNUP OFF-GRID, added 2026-10-02.
*  Every off-grid state above sits on an exact BURNUP node, on the stated
*  grounds that burnup does not move on transient timescales.  True -- but
*  the steady state the transient starts FROM does not sit on a node either:
*  the core deck runs at 10 900 MWd/t, inside the 10 000..12 500 interval,
*  so the burnup axis has been interpolated all along and never tested.
*
*  It costs nothing to test.  The depletion grid is finer than the COMPO
*  node set -- 'isnode' is 0 at 500, 3500 and 17 500 MWd/t -- so those three
*  points are exact DRAGON isotopics ON THE SAME DEPLETION PATH the COMPO
*  was built from, at burnups the COMPO must interpolate to reach.  Adding a
*  point at 11 250 to hit the core's own interval would instead have changed
*  the depletion path and contaminated every reference after it, so the
*  2500-wide interval the core uses is bounded by these wider ones rather
*  than measured directly: 2000, 3000 and 5000 MWd/t wide respectively.
*  DCA, TF and TG are held ON the grid so the error is burnup's alone.
*--------------------------------------------------------------

*  istep 2: BU 500, between COMPO nodes 0 and 2000
EVALUATE istep := 2 ;
GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
EVALUATE dbr tfbr tgbr := 0.72 900.0 750.0 ;
LIBRARY := DELETE: LIBRARY ;
LIBRARY := RbmkLib :: <<dbr>> <<tfbr>> <<tgbr>> <<tcool>> ;
LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
LIBSS := DELETE: LIBSS ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS   := DELETE: SYS ;
SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX  := DELETE: FLUX ;
FLUX  := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "A5BBURN" buend dbr tfbr tgbr kinf ;

*  istep 4: BU 3500, between COMPO nodes 2000 and 5000
EVALUATE istep := 4 ;
GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
EVALUATE dbr tfbr tgbr := 0.72 900.0 750.0 ;
LIBRARY := DELETE: LIBRARY ;
LIBRARY := RbmkLib :: <<dbr>> <<tfbr>> <<tgbr>> <<tcool>> ;
LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
LIBSS := DELETE: LIBSS ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS   := DELETE: SYS ;
SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX  := DELETE: FLUX ;
FLUX  := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "A5BBURN" buend dbr tfbr tgbr kinf ;

