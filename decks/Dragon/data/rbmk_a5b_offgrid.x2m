*--------------------------------------------------------------
*  ADDED 2026-10-02, with the widened axes.  The two intervals the
*  2026-10-01 rebuild created -- DCA 0.72..0.80 and TF 530..600 -- are
*  exactly where the coupled core interpolates, because that is the
*  subcooled channel inlet and the cold end of a low-power channel
*  (PROGRESS.md "A7b").  An interpolation gate that never samples them
*  does not cover the reason the axes were widened.  Midpoints of both.
*--------------------------------------------------------------

EVALUATE istep := 1 ;
GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
EVALUATE dbr tfbr tgbr := 0.76 565.0 625.0 ;
LIBRARY := DELETE: LIBRARY ;
LIBRARY := RbmkLib :: <<dbr>> <<tfbr>> <<tgbr>> <<tcool>> ;
LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
LIBSS := DELETE: LIBSS ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS   := DELETE: SYS ;
SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX  := DELETE: FLUX ;
FLUX  := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "A5BOFF" buend dbr tfbr tgbr kinf ;

EVALUATE istep := 7 ;
GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
EVALUATE dbr tfbr tgbr := 0.76 565.0 625.0 ;
LIBRARY := DELETE: LIBRARY ;
LIBRARY := RbmkLib :: <<dbr>> <<tfbr>> <<tgbr>> <<tcool>> ;
LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
LIBSS := DELETE: LIBSS ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS   := DELETE: SYS ;
SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX  := DELETE: FLUX ;
FLUX  := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "A5BOFF" buend dbr tfbr tgbr kinf ;

*--------------------------------------------------------------
*  AXIS DECOMPOSITION, added 2026-10-02.
*  LINEAR interpolation came out at 30.4 pcm against a 30 pcm gate, and
*  the two worst points are both at (DCA 0.76, TF 565) -- inside the two
*  intervals the widened axes created.  CUBIC is not the answer: it cuts
*  the error at BU 0 but takes it to -48 pcm at BU 20000, and NCR.f:139
*  has one global LCUBIC flag, so it cannot be chosen per axis.
*  Before widening a grid, find out WHICH axis is paying.  These five
*  states are off-grid in exactly one axis at a time, at BU 0 where the
*  error was worst, so the 30.4 pcm can be decomposed instead of guessed.
*--------------------------------------------------------------

*  all three on grid: the deck path itself
EVALUATE istep := 1 ;
GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
EVALUATE dbr tfbr tgbr := 0.80 600.0 750.0 ;
LIBRARY := DELETE: LIBRARY ;
LIBRARY := RbmkLib :: <<dbr>> <<tfbr>> <<tgbr>> <<tcool>> ;
LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
LIBSS := DELETE: LIBSS ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS   := DELETE: SYS ;
SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX  := DELETE: FLUX ;
FLUX  := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "A5BAXIS" buend dbr tfbr tgbr kinf ;

*  DCA only, inside the NEW 0.72..0.80 interval
EVALUATE istep := 1 ;
GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
EVALUATE dbr tfbr tgbr := 0.76 600.0 750.0 ;
LIBRARY := DELETE: LIBRARY ;
LIBRARY := RbmkLib :: <<dbr>> <<tfbr>> <<tgbr>> <<tcool>> ;
LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
LIBSS := DELETE: LIBSS ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
SYS   := DELETE: SYS ;
SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ;
FLUX  := DELETE: FLUX ;
FLUX  := FLU: LIBSS TRK SYS :: TYPE K B1 SIGS BUCK 0.0 EXTE 1.0E-6 ;
GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
ECHO "A5BAXIS" buend dbr tfbr tgbr kinf ;

*  TF only, inside the NEW 530..600 interval
EVALUATE istep := 1 ;
GREP: DONNEES :: GETVAL 'burn' <<istep>> >>buend<< ;
EVALUATE dbr tfbr tgbr := 0.80 565.0 750.0 ;
LIBRARY := DELETE: LIBRARY ;
LIBRARY := RbmkLib :: <<dbr>> <<tfbr>> <<tgbr>> <<tcool>> ;
LIBRARY := LIB: LIBRARY BURNUP :: EDIT 0 BURN <<istep>> MIX 6 MIX 7 ;
LIBSS := DELETE: LIBSS ;
LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
