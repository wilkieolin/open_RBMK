LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: END: ;
REAL kinf ;

GEOSS := GEO: :: CARCEL 4
  EDIT 0
  X- REFL X+ REFL MESHX -12.5 12.5
  Y- REFL Y+ REFL MESHY -12.5 12.5
  RADIUS  0.00  4.0  4.4  5.70  11.00
  MIX     1     2     3     3     3
  CLUSTER CARR ROD1 ROD2
  ::: CARR := GEO: TUBE 1
    MIX 4   NPIN 1  RPIN 0.00  APIN 0.00
    RADIUS 0.0000 0.75 ;
  ::: ROD1 := GEO: TUBE 2
    MIX 6 5   NPIN 6  RPIN 1.6  APIN 0.000000
    RADIUS 0.0000 0.5915 0.6815 ;
  ::: ROD2 := GEO: ROD1
    MIX 7 5   NPIN 12  RPIN 3.1  APIN 0.261799 ;
  ;
GEOFL := GEO: GEOSS :: SPLITR 16 4 8 24
  ::: CARR := GEO: CARR SPLITR 4 ;
  ::: ROD1 := GEO: ROD1 SPLITR 12 4 ;
  ::: ROD2 := GEO: ROD2 SPLITR 12 4 ;
  ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'SRP94-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'SRP94-FLUX' ALLG BATCH 100 TISO 30 120.0 ;

