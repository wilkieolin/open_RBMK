*----
*  METHOD STUDY bestmoc -- hypothesis H5+H3+H7+H9: best361 with MOC P1 flux (no transport correction)
*
*  GENERATED by decks/scripts/gen_meth.py -- edit that, not this file.
*  Fresh fuel, dca 0.72 / 0.35 / 0.02, TF 900 K, TG 750 K, coolant 573 K.
*  Output:  METHTAB 30 <dca> <k-inf>
*----
LINKED_LIST LIBRARY LIBSS GEOSS GEOFL TRKSS TRK SYS FLUX DONNEES ;
SEQ_BINARY  FTRKSS FTRK ;
MODULE      LIB: GEO: NXT: USS: ASM: FLU: GREP: DELETE: UTL: END: MCCGT: ;
PROCEDURE   RbmkLibZN2 RbmkGeoFine ;

REAL tfuel := 900.0 ;
REAL tgrap := 750.0 ;
REAL tcool := 573.0 ;
INTEGER ndc := 3 ;
INTEGER iv ;
REAL dca kinf ;

DONNEES := UTL: :: CREA 'dca' <<ndc>> = 0.72 0.35 0.02 ;

GEOSS GEOFL := RbmkGeoFine :: 4 ;
TRKSS FTRKSS := NXT: GEOSS ::
  EDIT 0 TITLE 'METH-SS' ALLG BATCH 100 TISO 8 15.0 ;
TRK FTRK := NXT: GEOFL ::
  EDIT 0 TITLE 'METH-FLUX' ALLG BATCH 100 ANIS 2 TISO 30 120.0 ;
TRK := MCCGT: TRK FTRK GEOFL :: EDIT 0 LCMD 3 MAXI 1 EPSI 1E-5 HDD 0. MCU 400000 KRYL 0 SCR 0 AAC 100 TMT ;

EVALUATE iv := 0 ;
WHILE iv ndc < DO
  EVALUATE iv := iv 1 + ;
  GREP: DONNEES :: GETVAL 'dca' <<iv>> >>dca<< ;
  LIBRARY := RbmkLibZN2 :: <<dca>> <<tfuel>> <<tgrap>> <<tcool>> ;
  LIBSS := USS: LIBRARY TRKSS FTRKSS :: EDIT 0 PASS 2 MAXST 300 ;
  SYS   := ASM: LIBSS TRK FTRK :: EDIT 0 ARM ;
  FLUX  := FLU: LIBSS TRK FTRK SYS :: TYPE K EXTE 1.0E-6 ;
  GREP: FLUX :: GETVAL 'K-INFINITY' 1 >>kinf<< ;
  ECHO "METHTAB" 30 dca kinf ;
  LIBRARY LIBSS SYS FLUX := DELETE: LIBRARY LIBSS SYS FLUX ;
ENDWHILE ;

ECHO "rbmk_meth_bestmoc completed" ;
END: ;
QUIT .
