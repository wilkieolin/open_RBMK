*----
*  RBMK-1000 LATTICE CELL with DLIB_99 (JEFF-2.2 99-group)
*  Using LIB module + SPH for homogenization
*----
LINKED_LIST LIBRARY TRACK_SS TRACK GEOM SYS FLUX EDI SPHED ;
MODULE LIB: SYBILT: G2S: SALT: MCCGT: USS: TONE: ASM: FLU: EDI: SPH: END: ;
PROCEDURE assertS ;

*==============================================================
*  Library: DLIB_99 (JEFF-2.2 99-group APOLIB)
*==============================================================
LIBRARY := LIB: ::
  EDIT 1
  NMIX 10
  CTRA APOL
  ANIS 2
  MIXS LIB: DRAGON FIL: DLIB_99
* MIX 1: Light water coolant
  MIX     1  573.0
     H1      = H1      4.90E-2
     O16     = O16     2.45E-2
* MIX 2: Zr-Nb pressure tube (Zr-2.5%Nb approx)
  MIX     2  573.0
     ZR90    = ZR90    2.22E-3
     ZR91    = ZR91    4.84E-4
     ZR92    = ZR92    7.40E-4
     ZR94    = ZR94    7.50E-4
     ZR96    = ZR96    1.21E-4
     NB93    = NB93    1.00E-4
* MIX 3: Gap gas (He)
  MIX     3  573.0
     HE4     = HE4     2.50E-5
* MIX 4: Zr calandria tube
  MIX     4  573.0
     ZR90    = ZR90    2.22E-3
     ZR91    = ZR91    4.84E-4
     ZR92    = ZR92    7.40E-4
     ZR94    = ZR94    7.50E-4
     ZR96    = ZR96    1.21E-4
* MIX 5: Graphite moderator (density 1.6 g/cm3)
  MIX     5  573.0
     C0      = C0      8.00E-2
* MIX 6: Central fuel pin (~2% enr UO2)
  MIX     6  900.0
     U235    = U235    5.50E-4  1
     U238    = U238    2.25E-2  1
     O16     = O16     4.61E-2
* MIX 7: Inner ring fuel
  MIX     7  900.0
     U235    = U235    5.50E-4  1
     U238    = U238    2.25E-2  1
     O16     = O16     4.61E-2
* MIX 8: Middle ring fuel
  MIX     8  900.0
     U235    = U235    5.50E-4  1
     U238    = U238    2.25E-2  1
     O16     = O16     4.61E-2
* MIX 9: Outer ring fuel
  MIX     9  900.0
     U235    = U235    5.50E-4  1
     U238    = U238    2.25E-2  1
     O16     = O16     4.61E-2
* MIX 10: Zr sheath/cladding
  MIX     10  600.0
     ZR90    = ZR90    2.22E-3
     ZR91    = ZR91    4.84E-4
     ZR92    = ZR92    7.40E-4
     ZR94    = ZR94    7.50E-4
     ZR96    = ZR96    1.21E-4
  ;

*==============================================================
*  Geometry for self-shielding (SYBILT)
*==============================================================
GEOM := GEO: :: CARCEL 9 1 1
  EDIT 0
  X- REFL MESHX -12.5 12.5 X+ REFL
  Y- TRAN MESHY -12.5 12.5 Y+ TRAN
  RADIUS  0.0     0.724  2.162  3.603  5.077
          5.5     5.85   6.45   6.5875  10.437
  MIX     1       1      1      1      1
          1       2      3      4       5
  CLUSTER ROD1 ROD2 ROD3 ROD4
  ::: ROD1 := GEO: TUBE 2
    MIX  6 10
    NPIN 1
    RPIN 0.0
    APIN 0.0
    RADIUS 0.0000 0.612 0.654 ;
  ::: ROD2 := GEO: TUBE 2
    MIX  7 10
    NPIN 6
    RPIN  1.4885 1.4885 1.4885 1.4885 1.4885 1.4885
    APIN  0.0    1.047  2.094  3.142  4.189  5.236
    RADIUS 0.0000 0.612 0.654 ;
  ::: ROD3 := GEO: TUBE 2
    MIX  8 10
    NPIN 12
    RPIN  2.8755 2.8755 2.8755 2.8755 2.8755 2.8755
          2.8755 2.8755 2.8755 2.8755 2.8755 2.8755
    APIN  0.0    0.524  1.047  1.571  2.094  2.618
          3.142  3.665  4.189  4.712  5.236  5.760
    RADIUS 0.0000 0.612 0.654 ;
  ::: ROD4 := GEO: TUBE 2
    MIX  9 10
    NPIN 18
    RPIN  4.3305 4.3305 4.3305 4.3305 4.3305 4.3305
          4.3305 4.3305 4.3305 4.3305 4.3305 4.3305
          4.3305 4.3305 4.3305 4.3305 4.3305 4.3305
    APIN  0.0    0.349  0.698  1.047  1.396  1.745
          2.094  2.443  2.793  3.142  3.491  3.840
          4.189  4.538  4.887  5.236  5.585  5.934
    RADIUS 0.0000 0.612 0.654 ;
  ;

*==============================================================
*  Self-shielding tracking
*==============================================================
TRACK_SS := SYBILT: GEOM ::
  TITLE 'RBMK-CELL SS'
  MAXR 500 QUA2 20 3 DP01 MAXZ 1000000 ;

*==============================================================
*  MOC tracking for flux
*==============================================================
G2S: GEOM :: EDIT 0 ;
TRACK TF_EXC := SALT: GEOM ::
  EDIT 3
  ALLG
  TSPC 8 20.0 REND
;
TRACK := MCCGT: TRACK TF_EXC ::
  CACB 4 AAC 80 TMT EPSI 1E-5 MCU 10000 ;

*==============================================================
*  Self-shielding (USS)
*==============================================================
LIBRARY := USS: LIBRARY TRACK_SS :: EDIT 1 PASS 3 GRMIN 18 ;

*==============================================================
*  Flux calculation
*==============================================================
SYS := ASM: LIBRARY TRACK TF_EXC :: EDIT 1 ARM ;
FLUX := FLU: LIBRARY SYS TRACK TF_EXC :: EDIT 1 TYPE K P1 EXTE 1.0E-6 ;

*==============================================================
*  Edition for SPH
*==============================================================
EDI := EDI: FLUX LIBRARY TRACK TF_EXC ::
  EDIT 2
  MICR ALL
  MERG MIX
  COND  4 9 13 17 21 28 40 51 61 73 82 89 100 108 117 122 128 135 139 145 154 161 186
        204 212 235 248 260 270 285 338 354
  SAVE ON COND26
  ;

*==============================================================
*  SPH Homogenization
*==============================================================
MACRO_SPH := EDI :: STEP UP COND26 ;
SPHED := SPH: MACRO_SPH TRACK TF_EXC :: EDIT 2 ITER 1.0E-5 ;

* Check k-infinity
assertS FLUX :: 'K-INFINITY' 1 1.0306 ;

END: ;
QUIT "LIST" .