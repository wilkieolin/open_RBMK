  MIX 3 FROM 3 SET 'burnup' 15000.0 SET 'DCA' 0.35 SET 'TF' 1500.0 ENDMIX
  MIX 4 FROM 4 SET 'burnup' 15000.0 SET 'DCA' 0.35 SET 'TF' 1500.0 ENDMIX
  MIX 5 FROM 5 SET 'burnup' 15000.0 SET 'DCA' 0.35 SET 'TF' 1500.0 ENDMIX
