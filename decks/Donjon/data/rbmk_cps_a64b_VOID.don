  MIX 5 FROM 5 SET 'burnup' 0.0 SET 'DCA' 0.72 SET 'TF' 1500.0 ENDMIX
  MIX 6 FROM 6 SET 'burnup' 0.0 SET 'DCA' 0.72 SET 'TF' 1500.0 ENDMIX
  MIX 7 FROM 7 SET 'burnup' 0.0 SET 'DCA' 0.72 SET 'TF' 1500.0 ENDMIX
  MIX 8 FROM 8 SET 'burnup' 0.0 SET 'DCA' 0.72 SET 'TF' 1500.0 ENDMIX
  MIX 9 FROM 9 SET 'burnup' 0.0 SET 'DCA' 0.72 SET 'TF' 1500.0 ENDMIX
  ;
MCUR := MREF ;
