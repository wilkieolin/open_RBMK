  COMPO CCpo 'EDICPS'
  MIX 1 FROM 1 SET 'burnup' 0.0 SET 'DCA' 0.35 SET 'TF' 900.0 ENDMIX
  MIX 2 FROM 2 SET 'burnup' 0.0 SET 'DCA' 0.35 SET 'TF' 900.0 ENDMIX
