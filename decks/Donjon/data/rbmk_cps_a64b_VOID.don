  MIX 2 FROM 2 SET 'burnup' 0.0 SET 'DCA' 0.72 SET 'TF' 1500.0 ENDMIX
  MIX 3 FROM 3 SET 'burnup' 0.0 SET 'DCA' 0.72 SET 'TF' 1500.0 ENDMIX
