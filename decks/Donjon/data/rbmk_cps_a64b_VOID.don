MREF := NCR: CCpo :: EDIT 0 MACRO LINEAR NMIX 9
  COMPO CCpo 'EDICPS'
  MIX 1 FROM 1 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 2 FROM 2 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 3 FROM 3 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 4 FROM 4 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 5 FROM 5 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 6 FROM 6 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 7 FROM 7 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 8 FROM 8 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  MIX 9 FROM 9 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX
  ;
MCUR := MREF ;
