  MIX 8 FROM 1 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 SET 'TG' 750.0 ENDMIX
  MIX 9 FROM 1 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 SET 'TG' 750.0 ENDMIX
  COMPO CCpo 'EDICPS'
  MIX 5 FROM 5 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 1500.0 ENDMIX ;
