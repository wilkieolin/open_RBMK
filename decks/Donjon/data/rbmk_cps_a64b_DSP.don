GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kk<< ;
ECHO "A64B TRI t0 15000.0 0.02 900.0" kk ;
OUTM := OUT: FLUX TRACK MCUR GEOM :: EDIT 2 INTG MIX ;
