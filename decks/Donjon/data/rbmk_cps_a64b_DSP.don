  MIX 1 FROM 1 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 2 FROM 2 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 3 FROM 3 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 4 FROM 4 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 5 FROM 5 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 6 FROM 6 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 7 FROM 7 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 8 FROM 8 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  MIX 9 FROM 9 SET 'burnup' 15000.0 SET 'DCA' 0.02 SET 'TF' 900.0 ENDMIX
  ;
MCUR := MREF ;
SYSTEM := TRIVAA: MCUR TRACK :: EDIT 0 ;
FLUX := FLUD: SYSTEM TRACK :: EDIT 0 EXTE 1.0E-7 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kk<< ;
ECHO "A64B REF 15000.0 0.02 900.0" kk ;
OUTM := OUT: FLUX TRACK MCUR GEOM :: EDIT 2 INTG MIX ;
OUTM SYSTEM FLUX := DELETE: OUTM SYSTEM FLUX ;
MREF MCUR := DELETE: MREF MCUR ;
