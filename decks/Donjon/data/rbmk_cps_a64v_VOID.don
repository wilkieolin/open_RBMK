  COMPO FCpo 'EDIRBMK'
  MIX 1 FROM 1 SET 'burnup' 10900.0 SET 'DCA' 0.35 SET 'TF' 1500.0 SET 'TG' 750.0 ENDMIX
  COMPO CCpo 'EDICPS'
  MIX 2 FROM 5 SET 'burnup' 10900.0 SET 'DCA' 0.35 SET 'TF' 1500.0 ENDMIX ;
SYSTEM := TRIVAA: MACRO TRACK :: EDIT 0 ;
FLUX := FLUD: SYSTEM TRACK :: EDIT 0 EXTE 1.0E-7 ;
