*----
*  Is TRIVAC's X+ VOID actually leaking?  The DONJON strip reads 16000 pcm
*  above DRAGON's transport k for the same geometry, i.e. it leaks far too
*  little -- which is what an unequivalenced diffusion model looks like, and
*  also what a boundary condition that is not taking effect looks like.
*  Three boundaries on identical data settle which.
*----
LINKED_LIST RCpo MACRO GEOM TRACK SYSTEM FLUX ;
SEQ_ASCII   _RCompo :: FILE './_RCompo' ;
MODULE      NCR: GEO: TRIVAT: TRIVAA: FLUD: GREP: DELETE: END: ;
REAL kk ;
RCpo := _RCompo ;
MACRO := NCR: RCpo :: EDIT 0 MACRO LINEAR NMIX 8
  COMPO RCpo 'EDIREFL'
  MIX 1 FROM 1 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  MIX 2 FROM 2 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  MIX 3 FROM 3 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  MIX 4 FROM 4 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  MIX 5 FROM 5 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  MIX 6 FROM 6 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  MIX 7 FROM 7 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  MIX 8 FROM 8 SET 'burnup' 0.0 SET 'DCA' 0.72 ENDMIX
  ;

GEOM := GEO: :: CAR2D 8 1
  X- REFL X+ VOID  Y- REFL Y+ REFL
  MESHX 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0  MESHY 0.0 25.0
  MIX 1 2 3 4 5 6 7 8 ;
TRACK := TRIVAT: GEOM :: EDIT 0 MAXR 40 DUAL 1 1 ;
SYSTEM := TRIVAA: MACRO TRACK :: EDIT 0 ;
FLUX := FLUD: SYSTEM TRACK :: EDIT 0 EXTE 1.0E-7 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kk<< ;
ECHO "BCTEST VOID" kk ;
GEOM TRACK SYSTEM FLUX := DELETE: GEOM TRACK SYSTEM FLUX ;
GEOM := GEO: :: CAR2D 8 1
  X- REFL X+ REFL  Y- REFL Y+ REFL
  MESHX 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0  MESHY 0.0 25.0
  MIX 1 2 3 4 5 6 7 8 ;
TRACK := TRIVAT: GEOM :: EDIT 0 MAXR 40 DUAL 1 1 ;
SYSTEM := TRIVAA: MACRO TRACK :: EDIT 0 ;
FLUX := FLUD: SYSTEM TRACK :: EDIT 0 EXTE 1.0E-7 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kk<< ;
ECHO "BCTEST REFL" kk ;
GEOM TRACK SYSTEM FLUX := DELETE: GEOM TRACK SYSTEM FLUX ;
GEOM := GEO: :: CAR2D 8 1
  X- REFL X+ ZERO  Y- REFL Y+ REFL
  MESHX 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0  MESHY 0.0 25.0
  MIX 1 2 3 4 5 6 7 8 ;
TRACK := TRIVAT: GEOM :: EDIT 0 MAXR 40 DUAL 1 1 ;
SYSTEM := TRIVAA: MACRO TRACK :: EDIT 0 ;
FLUX := FLUD: SYSTEM TRACK :: EDIT 0 EXTE 1.0E-7 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>kk<< ;
ECHO "BCTEST ZERO" kk ;
GEOM TRACK SYSTEM FLUX := DELETE: GEOM TRACK SYSTEM FLUX ;
ECHO "rbmk_refl_bc completed" ;
END: ;
QUIT .
