MESHX 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0 225.0 250.0 275.0 300.0 325.0 350.0 375.0
MESHY 0.0 25.0 50.0 75.0 100.0 125.0 150.0 175.0 200.0 225.0 250.0 275.0 300.0 325.0 350.0 375.0
MESHZ 0.0 100.0 200.0 300.0 400.0 500.0 600.0 700.0
;

*==============================================================
* MACROLIB: IAEA-3D pattern
*==============================================================
MACRO := MAC: ::
  EDIT 2 NGRO 2 NMIX 2 NIFI 1
  READ INPUT
* Mix 1: Fuel (IAEA fuel)
  MIX     1
      DIFFX  1.500E+00  4.000E-01
      TOTAL  3.000E-02  8.000E-02
     NUSIGF  0.000E+00  1.350E-01
   H-FACTOR  0.000E+00  1.350E-01
       SCAT  1 1 0.0  2 2 0.0  2.00E-02
* Mix 2: Reflector (IAEA reflector)
  MIX     2
      DIFFX  2.000E+00  3.000E-01
      TOTAL  4.000E-02  1.000E-02
     NUSIGF  0.000E+00  0.000E+00
   H-FACTOR  0.000E+00  0.000E+00
       SCAT  1 1 0.0  2 2 0.0  4.00E-02
  ;

*==============================================================
* FUEL MAP
*==============================================================
RBMK_2 MATEX := USPLIT: RBMK :: EDIT 1
  NGRP 2 MAXR 10000 NMIX 2
  NREFL 1 RMIX 2
  NFUEL 1 FMIX 1
  ;

*==============================================================
* MACINI
*==============================================================
MACRO2 MATEX := MACINI: MATEX MACRO :: EDIT 1 ;

*==============================================================
* TRACKING
*==============================================================
TRACK := TRIVAT: RBMK_2 ::
      TITLE 'RBMK MEDIUM TEST'
      EDIT 1 MAXR 10000 DUAL 3 3 ;

*==============================================================
* ASSEMBLY
*==============================================================
SYSTEM := TRIVAA: MACRO2 TRACK ::
      EDIT 1 ;

*==============================================================
* FLUX
*==============================================================
FLUX := FLUD: SYSTEM TRACK ::
      EDIT 2 ADI 5 EXTE 1.0E-7 1000 ;

*==============================================================
* POWER
*==============================================================
POWER := FLPOW: FLUX TRACK MATEX MACRO2
  :: EDIT 10 PTOT 500.0  PRINT ALL ;

*==============================================================
* CHECK
*==============================================================
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>Keff<< ;
ECHO "Keff=" Keff ;
assertS FLUX :: 'K-EFFECTIVE' 1 1.02 ;

ECHO "Medium test completed" ;
END: ;

QUIT .