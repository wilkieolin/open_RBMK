EVALUATE bsum := bsum bt + ;
ECHO "A5BBETAI" bu dca tf tg 5 bt ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 1 MEAN 'NUSIGF06' 1 18 >>a1<< ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 2 MEAN 'NUSIGF06' 1 18 >>a2<< ;
