*----
*  RBMK-1000 -- A5b VERIFICATION: can DONJON actually read the MULTICOMPO,
*  and does DRAGON's k-infinity survive the round trip?
*
*  "A COMPO exists on disk" is not the gate.  The artifact is only useful if
*  NCR: can interpolate it and TRIVAA:/FLUD: can solve with the result.  This
*  deck closes that loop end to end:
*
*    DRAGON cell  ->  EDI: 2 groups  ->  COMPO:  ->  _ACompo on disk
*                 ->  NCR:  ->  macrolib  ->  TRIVAA:  ->  FLUD:  ->  k
*
*  The geometry is a single homogeneous 25 cm cube, reflective on all six
*  faces.  There is no leakage, so the diffusion eigenvalue reduces exactly to
*  nu-Sigma-f / Sigma-a -- i.e. to k-infinity.  It must reproduce the value
*  DRAGON printed for the same branch point (A5BTAB in the Dragon listing).
*
*  A mismatch here means the condensation, the homogenisation or the COMPO
*  interpolation is losing something, and it would otherwise show up much
*  later as an unexplained bias in the 3-D core.
*
*  Interpolation is requested at an EXACT grid point, so LINEAR and CUBIC must
*  agree and the comparison is against DRAGON directly, not against a fit.
*----
LINKED_LIST Cpo Macro GEOM TRACK SYSTEM FLUX ;
SEQ_ASCII   _ACompo :: FILE './_ACompo' ;
MODULE      NCR: GREP: DELETE: END: ;
REAL bu dca tf tg tot a1 a2 bt bsum ;
Cpo := _ACompo ;
*  NUSIGF and NUSIGF0i each hold NMIX*NBFIS = 18 fissile-family entries.
*  MEAN over 1..18 is used rather than GETVAL of one entry: the common
*  factor 18 cancels in the ratio, and reading entry 1 alone would return
*  U-235's beta at every burnup -- which is exactly the wrong answer, since
*  the whole point is that Pu-239 (beta 0.00225) displaces it.

EVALUATE bu dca tf tg := 0.0 0.72 900.0 750.0 ;
Macro := NCR: Cpo :: EDIT 0 MACRO LINEAR NMIX 1 COMPO Cpo 'EDIRBMK'
  MIX 1 FROM 1 SET 'burnup' <<bu>> SET 'DCA' <<dca>>
               SET 'TF' <<tf>> SET 'TG' <<tg>> ENDMIX ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 1 MEAN 'NUSIGF' 1 18 >>a1<< ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 2 MEAN 'NUSIGF' 1 18 >>a2<< ;
EVALUATE tot := a1 a2 + ;
EVALUATE bsum := 0.0 ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 1 MEAN 'NUSIGF01' 1 18 >>a1<< ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 2 MEAN 'NUSIGF01' 1 18 >>a2<< ;
EVALUATE bt := a1 a2 + tot / ;
EVALUATE bsum := bsum bt + ;
ECHO "A5BBETAI" bu dca tf tg 1 bt ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 1 MEAN 'NUSIGF02' 1 18 >>a1<< ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 2 MEAN 'NUSIGF02' 1 18 >>a2<< ;
EVALUATE bt := a1 a2 + tot / ;
EVALUATE bsum := bsum bt + ;
ECHO "A5BBETAI" bu dca tf tg 2 bt ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 1 MEAN 'NUSIGF03' 1 18 >>a1<< ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 2 MEAN 'NUSIGF03' 1 18 >>a2<< ;
EVALUATE bt := a1 a2 + tot / ;
EVALUATE bsum := bsum bt + ;
ECHO "A5BBETAI" bu dca tf tg 3 bt ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 1 MEAN 'NUSIGF04' 1 18 >>a1<< ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 2 MEAN 'NUSIGF04' 1 18 >>a2<< ;
EVALUATE bt := a1 a2 + tot / ;
EVALUATE bsum := bsum bt + ;
ECHO "A5BBETAI" bu dca tf tg 4 bt ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 1 MEAN 'NUSIGF05' 1 18 >>a1<< ;
GREP: Macro :: STEP UP 'GROUP' STEP AT 2 MEAN 'NUSIGF05' 1 18 >>a2<< ;
